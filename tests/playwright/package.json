{
  "name": "bakers-playwright-bdd",
  "private": true,
  "version": "0.0.0",
  "description": "bakers.build BDD browser and HTTP contract tests",
  "scripts": {
    "bddgen": "bddgen --config playwright.bdd.config.ts",
    "test": "bddgen --config playwright.bdd.config.ts && playwright test --config playwright.bdd.config.ts",
    "test:unit": "vitest run --dir . --exclude '**/.features-gen/**' --exclude '**/node_modules/**'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
