# keytec project config. Consumed by `keytec-ai config to-env` -> PROVIDERS_REGISTRY_*/SANITIZE_*/INIT_* env -> the ddev-keytec addon.
init:
  default_sync_provider: gitlab-registry   # provider used by `ddev init` when no `--provider` is given
  profile: minimal                         # install profile — used by the `site-install` provider (INIT_PROFILE)
  build: "ddev composer install"           # BUILD phase — one shell string, run before the DB pull. Append your theme build, e.g. "ddev composer install; ddev exec 'cd web/themes/custom/mytheme && npm ci && npm run build'"
  deploy: "ddev drush deploy"              # DEPLOY phase — one shell string, run after the DB pull. `drush deploy` covers updatedb + config:import + cache:rebuild. KEYTEC_AI_SITE is available for --uri targeting.
  # worktree_fqdn: "{site}.{project}.ddev.site"  # per-site worktree hostname scheme for `ddev init-worktree`. {site}=site dir, {project}=worktree name. Default shown; e.g. "drupal-{site}.{project}.ddev.site".
  # worktree_fqdn_max: 62  # host-length budget for the ASSEMBLED worktree FQDN (INIT_WORKTREE_FQDN_MAX). `ddev init-worktree` clamps the worktree name so every emitted host stays within it: shorten (readable+hash7) -> degrade (wt-<hash7>) -> abort. Default 62: the real DDEV limit is the container hostname `<name>-web` at the kernel HOST_NAME_MAX of 64 (name <= 60); budgeting the FQDN to 62 keeps the name <= 52, an 8-char margin. Raise only for a DDEV/kernel that tolerates a longer container hostname.
  # worktree_pre: "cp ../<parent-worktree>/.ddev/.env .ddev/.env"  # project-owned step of `ddev init-worktree` run immediately BEFORE `ddev start`. One shell string, run verbatim in the worktree root ($PWD=repo root) with $DDEV_WORKTREE_NAME set (primary URL = https://$DDEV_WORKTREE_NAME.ddev.site), AFTER every generated file is written (config.worktree.yaml, .ddev/.env, .ddev/.gitignore, .env.ddev, root .gitignore) and BEFORE the containers come up. Empty/unset -> skipped; a non-zero step aborts init-worktree before `ddev start`. Prepare the worktree here (copy secrets/parent config, drop a docker-compose override).
  # worktree_post: "cd web/themes/custom/mytheme && npm ci && npm run build"  # project-owned FINAL step of `ddev init-worktree`. One shell string, run verbatim in the worktree root ($PWD=repo root) with $DDEV_WORKTREE_NAME set (primary URL = https://$DDEV_WORKTREE_NAME.ddev.site). Empty/unset -> skipped. Re-home project-specific worktree bootstrap here (build a CLI, copy a parent config) without forking the generic command.
  # db_cache_dir: "${XDG_CACHE_HOME:-$HOME/.cache}/keytec-ai/db"  # machine-global DB artifact cache (INIT_DB_CACHE_DIR). Shared by all projects/worktrees — a warm cache brings the DB up with zero network.
  # db_cache_keep: 5                                              # keep-N eviction of cached artifact files (*.snapshot.tgz, *.sql.gz), newest-by-mtime (INIT_DB_CACHE_KEEP). Only the snapshot path is cached; the SQL fallback is not.

providers:                                 # per-provider config (flattened to PROVIDERS_<NAME>_*)
  drush:                                    # `drush` pull provider (RAW deliver-file: dumps a site alias into .ddev/.downloads, ddev imports it)
    alias: ""                               # CHANGEME: source drush site alias, e.g. "@myproject.prod" -> PROVIDERS_DRUSH_ALIAS. RAW/unsanitized; needs `ddev auth ssh`. Empty -> clear "set providers.drush.alias" error, never a bogus pull.
  registry:                                # GitLab generic Package Registry (the sink). Config key is
                                           # hyphen-free (eval-safe PROVIDERS_REGISTRY_*); the provider
                                           # file stays gitlab-registry.yaml.
    project_path: keytec/db-anon           # central anon-DB registry (all projects)
    base_url: https://git.key-tec.de
    package_name: CHANGEME                 # base package name (unique per project)
    retention: 5
    # package_suffix: "-staging"           # appended verbatim to package_name. Default: a named site
                                           # (KEYTEC_AI_SITE != default) auto-appends "-<site>"; set this
                                           # (e.g. in .keytec-ai/sites/<site>.yml) to override that.

sanitize:
  pull_provider: platformsh                # DDEV provider `ddev sync-sanitize` uses for the RAW pull (`ddev pull`).
  # Any DDEV provider that fetches RAW production data (e.g. a ddev-platformsh / ddev-pantheon
  # provider yaml, the shipped `drush` provider, or a project-supplied one). init/sync-sanitize
  # pick --skip-import per provider: a DELIVER-FILE provider writes a dump into .ddev/.downloads
  # and declares `keytec-pull-mode: deliver-file` in its yaml (ddev then imports it, no
  # --skip-import); any other provider is treated as SELF-IMPORT — its db_pull_command must
  # download AND run its own import (called with --skip-import). WARNING: no trust boundary — a
  # wrong value here can pull unsanitized data straight into your local DB.
  push_provider: gitlab-registry           # DDEV provider `ddev sync-sanitize` uses to publish (`ddev push`).
  # The push provider owns the versioned registry upload + retention pruning (see gitlab-registry).
  drush:
    email: "user+%uid@example.invalid"     # --sanitize-email  ("no" = off)
    password: "no"                          # --sanitize-password ("no" = off, or fixed value)
  scrub:                                    # flat array "table.column=value" ({uid} template)
    - "users_field_data.name=user{uid}"
    - "users_field_data.init=user{uid}@example.invalid"
  extra_sql: sanitize/extra.sql            # optional escape-hatch file
