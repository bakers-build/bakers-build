#!/bin/bash
#ddev-generated
## Description: Install any missing QA toolchain packages via composer (keytec)
## Usage: qa-setup [--check]
## Example: "ddev qa-setup"
#
# One-off per project. Only installs what is MISSING — tool versions stay in the
# project's composer.lock (the addon never pins them). --check lists, installs nothing.
set -euo pipefail

# Operate from the Composer root so nested (monorepo) layouts work too.
cd "${DDEV_COMPOSER_ROOT:-${DDEV_APPROOT:-/var/www/html}}"

NEEDED=()
missing() { [ ! -x "vendor/bin/$1" ]; }

missing phpcs   && NEEDED+=(drupal/coder squizlabs/php_codesniffer)   # also provides phpcbf
missing phpmd   && NEEDED+=(phpmd/phpmd)
missing phpstan && NEEDED+=(phpstan/phpstan mglaman/phpstan-drupal)
missing phpunit && NEEDED+=(phpunit/phpunit)

if [ ${#NEEDED[@]} -eq 0 ]; then
  echo "QA toolchain complete — nothing to install."
  exit 0
fi

echo "missing tools -> packages: ${NEEDED[*]}"
if [ "${1:-}" = "--check" ]; then
  echo "(--check: nothing installed)"
  exit 0
fi
composer require --dev "${NEEDED[@]}"
echo "qa-setup done — try: ddev lint"
