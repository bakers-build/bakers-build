#!/bin/bash
# Maintained by Bakers; derived from keytec/keytec-ddev-addon (installed 2026-08-18).
## Description: Run phpcs against custom modules/themes (Bakers)
## Usage: phpcs [args...]
## Example: "ddev phpcs" or "ddev phpcs web/modules/custom/foo"
set -e
# Resolve the binary from the Composer root so nested (monorepo) layouts work;
# equals ${DDEV_APPROOT} for a root-level project. The ruleset itself lives at
# the project root and encodes its own file paths.
CR="${DDEV_COMPOSER_ROOT:-${DDEV_APPROOT:-/var/www/html}}"
BIN="${CR}/vendor/bin/phpcs"
if [ ! -x "${BIN}" ]; then
  echo "phpcs not found at ${BIN}. Run: ddev composer install" >&2
  exit 1
fi
exec "${BIN}" --standard="${DDEV_APPROOT}/phpcs.xml.dist" "$@"
