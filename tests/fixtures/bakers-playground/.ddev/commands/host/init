#!/bin/bash
## Description: Reinstall the local minimal Drupal fixture (destroys its database)
## Usage: init [--fresh]
## Example: "ddev init"
set -euo pipefail
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fresh) shift ;;
    *) echo "Unsupported fixture init argument: $1" >&2; exit 1 ;;
  esac
done
cd "${DDEV_APPROOT:-$(pwd)}"
node .bakers/scripts/setup-worktree.mjs
# Check the registry before startup: an existing name must belong to this exact root.
ddev list -j | node --input-type=module -e '
import { readFileSync, realpathSync } from "node:fs";
const root = realpathSync(".");
const name = [...readFileSync(".env.ddev", "utf8").matchAll(/^DDEV_WORKTREE_NAME=(.*)$/gm)].at(-1)[1];
const projects = JSON.parse(readFileSync(0, "utf8")).raw;
if (!Array.isArray(projects)) throw new Error("Cannot verify DDEV registry");
for (const project of projects) {
  let path = project.approot;
  try { path = realpathSync(path); } catch {}
  if ((project.name === name && path !== root) || (path === root && project.name !== name)) {
    throw new Error("DDEV name/approot collision; reconcile the registry before installing.");
  }
}
'
ddev describe -j | node --input-type=module -e '
import { readFileSync, realpathSync } from "node:fs";
const name = [...readFileSync(".env.ddev", "utf8").matchAll(/^DDEV_WORKTREE_NAME=(.*)$/gm)].at(-1)[1];
const project = JSON.parse(readFileSync(0, "utf8")).raw;
if (project.name !== name || realpathSync(project.approot) !== realpathSync(".")) {
  throw new Error("Effective DDEV name/approot differs from prepared identity; refusing installation.");
}
'
ddev start
ddev composer install
ddev drush site:install minimal -y
ddev drush cr
