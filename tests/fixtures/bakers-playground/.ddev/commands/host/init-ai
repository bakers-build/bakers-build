#!/bin/bash
#ddev-generated
## Description: One-time machine setup: sudoers rule so 'ddev hostname' needs no sudo prompt
## Usage: init-ai
## Example: "ddev init-ai"
#
# Installs /etc/sudoers.d/ddev-hostname so that 'ddev hostname' (and thus
# 'ddev init-worktree') can write /etc/hosts without a password prompt. Run once
# per machine/user. Requires sudo exactly once — that is the point.
#
# The rule grants passwordless sudo ONLY for the single ddev-hostname binary
# (not a blanket NOPASSWD), is per-user, and is validated with 'visudo -c' on a temp
# file BEFORE it is installed, so a malformed file can never reach /etc/sudoers.d/.
# This command is the ONLY place the addon touches sudoers; it never runs as part of
# automated init.
#
# Test seams (never set in normal use):
#   INIT_AI_DRY_RUN=1        -> run all logic + visudo -c on the temp file, but SKIP
#                               the real 'sudo install'; print the would-be values.
#   INIT_AI_SUDOERS_FILE=... -> override the existence-check path (dry-run testing).

set -euo pipefail

SUDOERS_FILE="${INIT_AI_SUDOERS_FILE:-/etc/sudoers.d/ddev-hostname}"
TARGET_FILE=/etc/sudoers.d/ddev-hostname
TARGET_USER="${SUDO_USER:-$USER}"

# Resolve the actual ddev-hostname path. Linux ddev installs it at /usr/bin, but
# Homebrew on macOS puts it under /opt/homebrew/bin (Apple Silicon) or
# /usr/local/bin (Intel). The sudoers rule must name the exact path ddev invokes.
DDEV_HOSTNAME_BIN="$(command -v ddev-hostname 2>/dev/null || echo /usr/bin/ddev-hostname)"

# Owner group for /etc/sudoers.d: macOS's root group is 'wheel', Linux uses 'root'.
case "$(uname -s)" in
  Darwin) ROOT_GROUP=wheel ;;
  *)      ROOT_GROUP=root ;;
esac

if [[ -f "${SUDOERS_FILE}" ]]; then
    echo "Already set up: ${SUDOERS_FILE} exists."
    echo "  Run 'sudo rm ${SUDOERS_FILE}' to reset."
    exit 0
fi

RULE="${TARGET_USER} ALL=(ALL) NOPASSWD: ${DDEV_HOSTNAME_BIN}"

# Build + validate the rule on a temp file BEFORE it can reach the live dir.
TMP_SUDOERS="$(mktemp)"
trap 'rm -f "${TMP_SUDOERS}"' EXIT
{
    echo "# Allows ddev hostname to write /etc/hosts without a password prompt."
    echo "${RULE}"
} > "${TMP_SUDOERS}"
chmod 0440 "${TMP_SUDOERS}"
visudo -c -f "${TMP_SUDOERS}" >/dev/null

if [[ -n "${INIT_AI_DRY_RUN:-}" ]]; then
    echo "sudoers-file=${TARGET_FILE}"
    echo "target-user=${TARGET_USER}"
    echo "rule=${RULE}"
    echo "mode=0440"
    echo "visudo=ok"
    echo "(dry-run: not installing)"
    exit 0
fi

echo "Installing sudoers rule for ${TARGET_USER} (requires sudo)..."
sudo install -m 0440 -o root -g "${ROOT_GROUP}" "${TMP_SUDOERS}" "${TARGET_FILE}"

echo
echo "✓ Done. 'ddev hostname' / 'ddev init-worktree' no longer prompt for sudo on this machine."
