            "title": "Ticket"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "minLength": 1,
            "description": "The measurement definition id, e.g. review_quality; every row name starts with it and a dot.",
            "title": "Measurement"
          },
          "rows": {
            "type": "array",
            "description": "The measurement’s metric rows.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1,
                  "description": "The metric name, e.g. review_quality.score.",
                  "title": "Name"
                },
                "value": {
                  "type": "number",
                  "description": "The numeric value.",
                  "title": "Value"
                },
                "unit": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "maxLength": 32,
                  "description": "The unit, e.g. ratio or hours.",
                  "title": "Unit"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "description": "One metric row.",
              "title": "Row"
            },
            "minItems": 1,
            "title": "Rows"
          },
          "label": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A label name to add to the ticket, e.g. retro.",
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "required": [
          "ticket",
          "name",
          "rows"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "description": "Every metric row of the ticket after the write.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The metric name.",
                  "title": "Name"
                },
                "value": {
                  "type": "number",
                  "description": "The numeric value.",
                  "title": "Value"
                },
                "unit": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The unit.",
                  "title": "Unit"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "description": "One metric row.",
              "title": "Metric"
            },
            "title": "Metrics"
          }
        }
      }
