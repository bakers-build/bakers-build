    {
      "name": "tool_api__bakers_metric_write",
      "title": "Record a measurement",
      "description": "Replaces the ticket’s metric rows whose name starts with the definition name and a dot with the given rows, keeping every other row and label, and optionally adds a label by name (created in the ticket’s workspace when missing).",
