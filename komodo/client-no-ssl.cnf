# MariaDB client: do not attempt TLS. The deployed wodby/mariadb server runs
# without TLS; newer MariaDB clients default to requiring SSL, producing
# "ERROR 2026 (HY000): TLS/SSL error: SSL is required, but the server does not
# support it" on drush sql:create / sql:connect. Disable client-side SSL.
[client]
ssl=0
ssl-verify-server-cert=0

[client-mariadb]
ssl=0
