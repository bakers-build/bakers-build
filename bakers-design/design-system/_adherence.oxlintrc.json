{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/atoms/**",
              "components/molecules/**",
              "components/organisms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: key, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute[name.name='key'] > Literal[value!=/^(?:dashboard|board|nodes|billing)$/]",
        "message": "<NavItem> key must be one of 'dashboard' | 'board' | 'nodes' | 'billing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|kind|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, kind, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:running|lease)$/]",
        "message": "<Avatar> kind must be one of 'running' | 'lease'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCardLease'] > JSXAttribute > JSXIdentifier[name!=/^(?:machine|mine|key|ref|className|style|children)$/]",
        "message": "<BoardCardLease> doesn't accept that prop. Declared props: machine, mine."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|count|accent|empty|children|key|ref|className|style|children)$/]",
        "message": "<BoardColumn> doesn't accept that prop. Declared props: name, count, accent, empty, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardColumn'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:running|attention)$/]",
        "message": "<BoardColumn> accent must be one of 'running' | 'attention'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|standard|xs|cta)$/]",
        "message": "<Button> variant must be one of 'primary' | 'standard' | 'xs' | 'cta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:projectsLabel|conductorsCount|mineOn|querystring|key|ref|className|style|children)$/]",
        "message": "<FilterBar> doesn't accept that prop. Declared props: projectsLabel, conductorsCount, mineOn, querystring."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|value|count|active|key|ref|className|style|children)$/]",
        "message": "<FilterButton> doesn't accept that prop. Declared props: caption, value, count, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeaseBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:machine|mine|key|ref|className|style|children)$/]",
        "message": "<LeaseBadge> doesn't accept that prop. Declared props: machine, mine."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrioTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|key|ref|className|style|children)$/]",
        "message": "<PrioTag> doesn't accept that prop. Declared props: level."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrioTag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:p1|p2)$/]",
        "message": "<PrioTag> level must be one of 'p1' | 'p2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|count|countAlert|updated|id|children|key|ref|className|style|children)$/]",
        "message": "<SectionShell> doesn't accept that prop. Declared props: title, count, countAlert, updated, id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|className|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: state, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:running|attention|wait|online|stale|offline)$/]",
        "message": "<StatusDot> state must be one of 'running' | 'attention' | 'wait' | 'online' | 'stale' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|withDot|icon|children|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: state, withDot, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:running|attention|needs_input|waiting|wait|critical)$/]",
        "message": "<StatusPill> state must be one of 'running' | 'attention' | 'needs_input' | 'waiting' | 'wait' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|cap)$/]",
        "message": "<Tag> variant must be one of 'default' | 'cap'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TicketRowAssignee'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|name|key|ref|className|style|children)$/]",
        "message": "<TicketRowAssignee> doesn't accept that prop. Declared props: initials, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|children|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: on, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "NavItem": {
        "replaces": []
