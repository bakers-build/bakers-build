{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakers.build/schema/addon-pi/options.schema.json",
  "title": "@bakers-build/addon-pi options",
  "$ref": "https://bakers.build/schema/harness-options.schema.json",
  "properties": {
    "permissions": { "enum": ["system", "custom"] },
    "sandbox": false,
    "config": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["extensions"],
      "additionalProperties": false
    },
    "provider": { "type": "string", "description": "Model provider." },
    "thinking": {
      "type": "string",
      "description": "Thinking level; effort wins when both are set."
    },
    "approve": {
      "type": "boolean",
      "description": "Trust the worktree's project-local pi files. Default: false."
    }
  },
  "unevaluatedProperties": false
}
