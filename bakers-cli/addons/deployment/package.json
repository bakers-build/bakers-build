{
  "name": "@bakers-build/addon-deployment",
  "version": "0.0.1",
  "description": "bakers.build deployment command plugin: `bakers deployment tickets` — the release batch computed from a git-log range.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/src/index.js",
    "./preset": "./dist/src/preset.js",
    "./options.schema.json": "./options.schema.json"
  },
  "files": [
    "dist/src",
    "options.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bakers-build/addon-remote-drupal": "workspace:^",
    "@bakers-build/conductor": "workspace:^",
    "@bakers-build/core": "workspace:^"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@bakers-build/addon-remote-drupal": "workspace:^",
    "@bakers-build/conductor": "workspace:^",
    "@bakers-build/core": "workspace:^",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
