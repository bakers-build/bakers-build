{
  "name": "@bakers-build/addon-runtime-docker",
  "version": "0.0.1",
  "description": "Start each agent run in its own Docker or Podman container.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/src/index.js",
    "./preset": "./dist/src/preset.js",
    "./options.schema.json": "./options.schema.json",
    "./contract": "./dist/src/contract.js"
  },
  "files": [
    "dist/src",
    "image",
    "options.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bakers-build/conductor": "workspace:^",
    "@bakers-build/core": "workspace:^"
  },
  "devDependencies": {
    "@bakers-build/conductor": "workspace:^",
    "@bakers-build/core": "workspace:^",
    "typescript": "^5.9.0"
  }
