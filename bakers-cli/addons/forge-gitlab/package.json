{
  "name": "@bakers-build/addon-forge-gitlab",
  "version": "0.1.0",
  "description": "bakers.build forge backend for GitLab: a Project Access Token (role Developer, with an expiry date). Implements @bakers-build/addon-forge's ForgeBackend contract.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. addons/forge-gitlab/tests"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bakers-build/addon-forge": "workspace:^",
    "@bakers-build/core": "workspace:^"
  },
  "devDependencies": {
    "@bakers-build/addon-forge": "workspace:^",
    "@bakers-build/core": "workspace:^",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
