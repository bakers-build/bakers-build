{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailscale SSH options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ssh_user"
  ],
  "properties": {
    "ssh_user": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f:/?#@\\\\]+$",
      "description": "Account in the published SSH connection URL."
    },
    "ssh_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 22,
      "description": "Port in the published SSH connection URL, from 1 through 65535."
    }
  }
}
