{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakers.build/schema/addon-herdr/options.schema.json",
  "title": "herdr executor + worktree options",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "Fallback agent command when the conductor supplies none. Default `claude`."
    },
    "open": {
      "type": "object",
      "description": "Startup layout of a fresh worktree; `{}` opts out. Templates expand {identifier}, {branch}, {title}, {worktree_path}.",
      "properties": {
        "command": {
          "type": "string"
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pane"
          }
        },
        "tab_label": {
          "type": "string"
        },
        "panel_label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "root": {
      "type": "string",
      "description": "Main clone; otherwise derived from the git common dir."
    },
    "default": {
      "$ref": "#/$defs/state"
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "launch_watch": {
      "type": "object",
      "description": "Launch-watch windows: wait start_timeout_ms (default 60000) for the wrapper to start, then timeout_ms (default 4000) in which an immediate agent exit fails the launch.",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "start_timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "worktree_dir": {
      "type": "string",
      "description": "Directory (relative to root, or absolute) for new worktrees. Default `.bakers-worktrees`."
    },
    "base_branch": {
      "type": "string",
      "description": "Base ref for new branches. Default: the upstream of the root's HEAD."
    },
    "auto_setup_merge": {
      "type": "boolean",
      "description": "`true` leaves Git's branch.autoSetupMerge alone. Default `false`."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pane": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": ["right", "down"]
        },
        "command": {
          "type": "string"
        },
        "focus": {
          "type": "boolean"
        }
      },
      "required": ["direction", "command"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "description": "Per-state layout. Templates expand {identifier}, {title}, {title_slug}, {run_uuid}, {workspace_path}.",
      "properties": {
        "tab_label": {
          "type": "string"
        },
        "workspace_label": {
          "type": "string"
        },
        "panel_label": {
          "type": "string"
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pane"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
