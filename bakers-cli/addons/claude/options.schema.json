{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakers.build/schema/addon-claude/options.schema.json",
  "title": "@bakers-build/addon-claude options",
  "$ref": "https://bakers.build/schema/harness-options.schema.json",
  "properties": {
    "measure": {
      "type": "boolean",
      "description": "Start the launch through the addon's measuring proxy.",
      "default": false
    },
    "model": {
      "description": "Passed as `--model`; replaces `opus`, `sonnet` and `fable` with one custom candidate."
    },
    "effort": {
      "description": "Passed as `--effort`."
    }
  },
  "unevaluatedProperties": false
}
