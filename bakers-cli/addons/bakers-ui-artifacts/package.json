  "description": "bakers.build TUI: an Artifacts tab on ticket detail, reading assets-ai/<bakers.build-nnn>/.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/src/panel.js",
    "./preset": "./dist/src/preset.js",
