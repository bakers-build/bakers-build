{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bakers.build/schema/project.schema.json",
  "title": "ProjectConfig",
  "description": "A project's committed conductor configuration: .bakers/project.config.js and its variants .bakers/project.<name>.config.js.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "Configuration schema version."
    },
    "project": {
      "type": "object",
      "description": "The bakers.build project this repository belongs to.",
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty",
          "description": "Project name on the server; BAKERS_PROJECT overrides it."
        },
        "workspace": {
          "$ref": "#/$defs/nonempty",
          "description": "Team workspace the project belongs to."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "addons": {
      "type": "array",
      "description": "Addons this project uses.",
      "items": {
        "$ref": "#/$defs/addon"
      }
    },
    "server": {
      "$ref": "#/$defs/slot",
      "description": "Explicit server slot; wins over an addon's."
    },
    "executor": {
      "$ref": "#/$defs/slot",
      "description": "Explicit executor slot; the machine's wins over it."
    },
    "worktree": {
      "$ref": "#/$defs/slot",
      "description": "Explicit worktree slot; wins over an addon's."
    },
    "states": {
      "type": "array",
      "description": "States this conductor serves; empty or absent serves all.",
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "prompt": {
      "type": "string",
      "description": "Agent prompt; placeholders {identifier}, {state}, {run_uuid}, {ticket_uuid}."
    },
    "poll_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Poll interval in milliseconds. Default 5000."
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Run lease in seconds. Default 300."
    },
    "restart_on_change": {
      "type": "boolean",
      "description": "Restart the foreground conductor when a config file changes. Default true."
    },
    "capture_logs": {
      "type": "boolean",
      "description": "Upload transcripts where the server allows it. Default true."
    },
    "hooks": {
      "type": "object",
      "description": "Shell commands the conductor runs in a ticket's worktree.",
      "properties": {
        "after_create": {
          "type": "string"
        },
        "before_run": {
          "type": "string"
        },
        "after_run": {
          "type": "string"
        },
        "after_done": {
          "type": "string"
        },
        "on_freeze": {
          "type": "string"
        },
        "on_resume": {
          "type": "string"
        },
        "provision_up": {
          "description": "Command, or commands by profile, offered to runs as provision_up(profile?).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "marketplaces": {
      "type": "array",
      "description": "Agent plugin marketplaces every run of this project installs.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^(https?://|ssh://|git@[^:\\s]+:)\\S+$",
            "description": "a remote Git URL (https, ssh or git@)"
          },
          "ref": {
            "$ref": "#/$defs/nonempty",
            "description": "Branch or tag."
          },
          "plugins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "required": [
          "url",
          "ref",
          "plugins"
        ],
        "additionalProperties": false
      }
    },
    "select_agent": {
      "function": true,
      "description": "Function choosing the agent for a ticket; replaces the shipped selection."
    }
  },
  "required": [
    "project"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "permissions": {
      "type": "object",
      "description": "Shared run permissions for every agent.",
      "properties": {
        "mode": {
          "enum": [
            "sandbox",
            "system",
            "yolo"
          ]
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "deny_read": {
              "$ref": "#/$defs/string_list"
            },
            "allow_write": {
              "$ref": "#/$defs/string_list"
            },
            "trusted_commands": {
              "$ref": "#/$defs/string_list"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "addon": {
      "description": "A package name, or { use, alias?, with? }.",
      "if": {
        "type": "string"
      },
      "then": {
        "$ref": "#/$defs/nonempty"
      },
      "else": {
        "type": "object",
        "properties": {
          "use": {
            "$ref": "#/$defs/nonempty"
          },
          "alias": {
            "$ref": "#/$defs/nonempty"
          },
          "with": {
            "description": "The addon's options."
          },
          "priority": {
            "function": true
          }
        },
        "required": [
          "use"
        ],
        "additionalProperties": false
      }
    },
    "slot": {
      "description": "{ use, export?, with? }, or a constructed plugin carrying its kind.",
      "if": {
        "type": "object",
        "required": [
          "kind"
        ]
      },
      "then": {
        "type": "object"
      },
      "else": {
        "type": "object",
        "properties": {
          "use": {
            "$ref": "#/$defs/nonempty"
          },
          "export": {
            "$ref": "#/$defs/nonempty"
          },
          "with": {
            "description": "Options passed to the factory."
          }
        },
        "required": [
          "use"
        ],
        "additionalProperties": false
      }
    }
  }
}
