/vendor/
node_modules/
# bakers CLI monorepo (BB-215 topology): per-package tsc output. bakers-cli/.gitignore
# also ignores `dist/`+`publish/` recursively; these keep the root view explicit.
/bakers-cli/*/dist/
/bakers-cli/addons/*/dist/
/bakers-cli/.pnpm-store/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
.bakers-worktrees
/web/sites/*/files/
/web/sites/*/settings.php
# bakers.build: site settings are committed (ddev-local DB creds + fixed salt; real
# secrets like the GitLab token come from env via getenv).
!web/sites/test/settings.php
!web/sites/default/settings.php
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
# Local-only test site (test multisite retired; dir is ddev-local, never committed).
/web/sites/test/
# BB-359: BrowserTestBase writes one throwaway site per functional test into
# here, and `ddev bakers-test-functional` creates the directory itself. Running
# the functional gate must not dirty the tree.
/web/sites/simpletest/
.pnpm-store/*

/bakers-cli/junit-vitest.xml
# BB-326: the Bun renderer suite writes its OWN report, never the vitest one.
/bakers-cli/junit-tui.xml

/.phpunit.result.cache
/.phpunit.cache/
/.phpcs-cache
/.eslintcache
/.stylelintcache

/oauth-keys/
/keys/

/.ddev/.global_commands/
/.ddev/.homeadditions/
/.ddev/.downloads/
/.ddev/.webimageBuild/
/.ddev/.dbimageBuild/
/.ddev/.ddev-docker-compose-full.yaml
/.ddev/.ddev-docker-compose-base.yaml
# #ddev-generated per machine/worktree: mkcert cert + private key and the router
# config, both carrying the worktree-specific project name. Never committed.
/.ddev/traefik/
/.ddev/.bakers-e2e/
/.ddev/.bakers-keytec/
/.ddev/.bakers-playground/
/.ddev/.bakers-test/
# Legacy local environment files may contain private settings; keep them ignored.
/.ddev/.env
/.ddev/.env.web
# Traefik: per-worktree TLS cert + router config, generated by `ddev start` /
# project setup from the worktree's project name. Transient — never committed.
/.ddev/traefik/certs/
/.ddev/traefik/config/

# Local agent workspaces (may contain nested git repos).
/workspaces/
/.claude/worktrees/
/.claire/

# dropsh per-session cache — written into whatever dir dropsh runs from
# (bakers-cli/, .bakers/, .claude/skills/**), so match the dir name at any depth.
**/.dropsh/

# conductor runtime log (written into the conductor config dir)
/.bakers/log.txt
# per-worktree bootstrap sentinel (BB-142 worktree-post.sh) — never commit
/.bakers/.worktree-post-done
# BB-376: the bakers ui auto-refresh signal — a bump file, never content
/.bakers/ui-refresh
# pi agent transcripts (BB-220 --session-dir pin) — a pi run must not dirty the worktree
/.bakers/pi-sessions/

# per-developer conductor overrides (Kürzel consumer + secret) — never commit
*.config.local.js
# The operator's own audience declaration (`@bakers-build/bb-workflow` › boundaries › Audience and register).
# Written by the person the handoffs address, never committed: a preference about how someone
# wants to be spoken to is theirs, not the repository's. `*.config.local.js` above does not
# match a `.md`, so this rule is stated rather than inherited.
/.bakers/audience.local.md
# …but the committed scaffold TEMPLATE (secret-from-env, no literal secret) must be tracked
!bakers-cli/templates/conductor.config.local.js
# BB-256: a hand-written connection config pointing at the local DDEV site,
# for trying the Dashboard before the endpoint is deployed. Carries inline
# credentials for a throwaway install — never committed.
.bakers/local-ddev.bakers.config.js
.pnpm-store
/.env.ddev

# Transient run artifacts: reports, logs, screenshots, throwaway probe scripts.
# Written per ticket, never committed, reaped with the worktree at `done`.
# The ticket carries no links to these files — see
# docs/specs/BB-371-evidence-and-links-layout.spec.md (D1, D3).
#
# `/issues/` is deliberately NOT reinstated here: BB-371 replaced that root
# with this one, so re-adding it would ignore a path nothing writes any more.
/assets-ai/

# playwright-cli scratch output (page snapshots, console logs, screenshots) when
# the browser walk is driven from the repository root rather than from the theme.
# phpcs already skips it; the theme's own .gitignore covers the theme-level dir.
/.playwright-cli/

# superpowers:brainstorming visual companion — mockup screens and click events
# written during a design step. Local scratch, never part of the deliverable.
/.superpowers/

# BB-500: @bakers-build/addon-ports' per-worktree tunnel state. Absence means off —
# never a committed artifact.
/.bakers/ports-tunnels.json
# The conductor's observed frozen tickets, beside its config (freeze hooks).
/.bakers/*.frozen.json
# BB-569: Claude measure settings copied into the worktree for the run
/.bakers/claude-measure.settings.json
/phpunit.shard.xml

/.env.ddev.*.tmp
