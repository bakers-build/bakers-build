<?php

/**
 * @file
 * Display names that differ from account names, for tool output tests.
 */

use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_user_format_name_alter().
 */
function bb_display_name_test_user_format_name_alter(string &$name, AccountInterface $account): void {
  $name = 'Display ' . $name;
}
