<?php

/**
 * @file
 * Install hooks for bb_core.
 */

declare(strict_types=1);

use Drupal\bb_core\Entity\BbConductor;
use Drupal\bb_core\Install\CliConsumer;
use Drupal\bb_core\Install\DefaultWorkspace;

/**
 * Creates the content every bakers.build site requires.
 *
 * Every install path (recipe, existing-config, plain site install) runs
 * hook_install(). Each ensure() is idempotent and keeps what exists.
 */
function bb_core_install(): void {
  DefaultWorkspace::ensure();
  CliConsumer::ensure();
}

/**
 * Adds the conductor's credential_health field.
 */
function bb_core_update_11001(): void {
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'credential_health',
    'bb_conductor',
    'bb_core',
    BbConductor::credentialHealthFieldDefinition(),
  );
}
