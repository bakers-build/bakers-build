{#
/**
 * @file
 * Keep checkbox inputs at their native rendering — the text-input SDC classes
 * from input.html.twig would distort them. (Theme-wide safety; the auth forms
 * have no checkboxes.)
 */
#}
<input{{ attributes.addClass(['focus-visible:outline-2', 'focus-visible:outline-offset-2', 'focus-visible:outline-focus-ring']) }} />{{ children }}
