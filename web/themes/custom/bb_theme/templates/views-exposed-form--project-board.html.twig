{# The Board's hidden chip values (bb_board_summary).

   State, Assignee, Priority, Work state and Parent have no picker here: their
   chips ARE those filters. Active values ride along as hidden inputs, so a
   change to any other control (BEF autosubmit) keeps the chip selection.
   Clear filters sits on the first chip group's heading, not in this form. #}
<div{{ attributes.addClass(['hidden']) }} role="group" aria-label="Board filters">
  {% for key in ['state', 'assignee', 'priority', 'work_state'] %}
    {% for value in form[key]['#props'].values|default([]) %}
      <input type="hidden" name="{{ key }}[]" value="{{ value }}">
    {% endfor %}
  {% endfor %}
  {% for value in form.parent_id['#props'].values|default([]) %}
    <input type="hidden" name="parent_id" value="{{ value }}">
  {% endfor %}
  {{ form|without('state', 'assignee', 'priority', 'work_state', 'parent_id', 'clear', 'actions') }}
</div>
