{#
/**
 * @file
 * Onboarding wizard presenter: the form composes the chrome it lives in.
 *
 * IT COMPOSES COMPONENTS AND NOTHING ELSE. There is no markup here — no
 * wrapper, no utility class, no hand-written grid: `bb_theme:gate` is the
 * same frame sign-in uses (brand band left, step right), and
 * `bb_theme:brand` is the mark. This template only says which parts of the
 * form go where.
 *
 * THE COPY TRAVELS WITH THE STEP because it is the form's. `#bb_copy` is
 * built per step by `BbOnboardingWizardForm` and handed to the gate as
 * props — scalars, so the gate renders the heading, the sentence and the
 * left band's explanation in the one treatment it has for them. One HTMX swap therefore replaces the
 * explanation and the fields together. Taking the copy from the Island Profile
 * instead would pin one heading to both steps: its layout settings are static
 * config.
 *
 * PRINTING THE ELEMENTS, NOT REBUILDING THEM, is `bb-login-form.html.twig`'s
 * rule and holds here for the same reason: `form-element-label.html.twig` and
 * `input.html.twig` already render through `bb_theme:form_label` and
 * `bb_theme:form_input`, so core's own `for`/`id` pair stays the single
 * source for that binding.
 *
 * THERE IS NO `form--bb-onboarding-wizard-form.html.twig` BESIDE THIS ONE.
 * The wrapper this hook's form used to carry was `<form{{ attributes }}>` with
 * `{{ children }}` inside it — character for character what core's own
 * `form.html.twig` already renders — so it said nothing and is deleted.
 *
 * @see web/themes/custom/bb_theme/components/gate/gate.twig
 * @see web/modules/custom/bb_core/src/Form/BbOnboardingWizardForm.php
 */
#}
{# The form's parts stand as direct children of `bb_theme:gate_form`, as every gate form's do, so
   the frame spaces them. `fields` is unwrapped for that: its container carries no markup. #}
{% set parts %}
  {{ form.messages }}
  {{ form.ai_use_notice }}
  {% for key, child in form.fields %}{% if key|first != '#' %}{{ child }}{% endif %}{% endfor %}
  {{ form.actions }}
  {{ form|without('#bb_copy', 'messages', 'ai_use_notice', 'fields', 'actions') }}
{% endset %}
{% set card %}{{ include('bb_theme:gate_form', {tag: 'div', content: parts}, with_context = false) }}{% endset %}
{{ include('bb_theme:gate', {
  title: form['#bb_copy'].title,
  description: form['#bb_copy'].description,
  explanation: form['#bb_copy'].explanation,
  progress: form['#bb_copy'].progress,
  steps: form['#bb_copy'].steps,
  focus_title: true,
  mark: include('bb_theme:brand', {size: 'compact'}, with_context = false),
  content: card,
}, with_context = false) }}
