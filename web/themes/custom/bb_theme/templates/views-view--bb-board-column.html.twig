{# One paged board column. The page display uses Display Builder; this
   suggestion is the `bb_board_column` display plugin only.

   @see \Drupal\bb_core\Plugin\views\display\BbBoardColumn
#}
{% set col = view.getTitle %}
{% set col_tone = {
  'backlog': 'wait',
  'intake': 'attention',
  'working': 'running',
  'done': 'idle',
} %}
{% set tone = col_tone[view.current_display]|default('neutral') %}
<section{{ attributes.addClass(['flex', 'flex-col', 'min-h-38', 'flex-1', 'shrink-0', 'basis-38', 'min-w-38', 'bg-surface-2', 'border', 'border-border-2', 'rounded-sm']).setAttribute('data-col', col).setAttribute('data-count', view.total_rows|default(0)) }}>
  <div class="flex flex-col gap-1 px-2 py-2 border-b border-border-2">
    <h2 class="flex items-center justify-between gap-2 m-0">
      {{ include('bb_theme:badge', {label: col|upper, tone: tone, dot: true}, with_context = false) }}
      <span class="text-caption text-text-light">{{ view.total_rows|default(0) }}</span>
    </h2>
  </div>
  <div class="flex flex-col gap-2 flex-1 p-2">
    {% if rows %}
      {{ rows }}
    {% elseif empty %}
      {{ empty }}
    {% endif %}
  </div>
  {{ pager }}
</section>
