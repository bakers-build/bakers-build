{# The `bb_board` style hands over board-card props as `#rows`.

   Views style templates only receive view/options/rows/title, so the payload
   uses that rows key. Column chrome (header, pager, the empty sentence) lives
   on `views-view--bb-board-column.html.twig`. A done card's facts (`done_*`,
   `mr_*`) are board-card props; the card draws their footer itself.

   @see \Drupal\bb_core\Plugin\views\style\BbBoard
#}
{% for card in rows %}
  {{ include('bb_theme:board-card', card, with_context = false) }}
{% endfor %}
