{#
/**
 * @file
 * Presenter override for the bb_duration element: the form_input SDC, plus
 * completing a bare whole hour to H:00 when the field loses focus. The server
 * does the same, so the field works without JS.
 *
 * @see web/themes/custom/bb_theme/templates/input.html.twig
 */
#}
{{ include('bb_theme:form_input', {
  attributes: attributes
    .setAttribute('x-data', '{}')
    .setAttribute('x-on:blur', "const v = $el.value.trim(); if (/^[0-9]{1,6}$/.test(v)) { $el.value = v + ':00'; $el.dispatchEvent(new Event('input', { bubbles: true })) }"),
  disabled: attributes.offsetExists('disabled'),
  readonly: attributes.offsetExists('readonly'),
  compact: element['#compact']|default(false),
}, with_context = false) }}{{ children }}
