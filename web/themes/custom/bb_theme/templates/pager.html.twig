{#
/**
 * @file
 * Pager for bb_theme (the active theme on the bakers routes).
 *
 * This is Drupal core's `pager.html.twig` adopted 1:1 — same presenter logic
 * (`current == key` → active, first/previous/ellipses/pages/next/last), fed the
 * same `PagerPreprocess::preprocessPager()` variables — with only the classes
 * swapped for the dashboard's themed (Tailwind) look. The pager is deliberately
 * NOT routed through an SDC component: the SDC prop layer coerced `current` to a
 * string, and in the component Twig sandbox `"2" == 1` evaluates true, so the
 * wrong page was marked current. Consuming the raw preprocess `current` (an int)
 * here keeps `current == key` correct, exactly like core.
 *
 * Available variables mirror core: heading_id, pagination_heading_level, items
 * (first/previous/next/last + pages keyed by page number, each {href,attributes,text}),
 * current (current page number), ellipses.{previous,next}.
 *
 * @see \Drupal\Core\Pager\PagerPreprocess::preprocessPager()
 *
 * Styled with token utilities only — BB-504 review finding B/5: this template used to lean on
 * a global `.js-pager__items a { display: inline-flex }` base rule in `css/app.src.css` plus
 * several arbitrary Tailwind values (`min-w-[26px]`, `px-[7px]`, `rounded-[var(--radius-xs,5px)]`,
 * `bg-primary/15`, `gap-[4px]`, `mt-[12px]`). Every link already carries its own `inline-flex` in
 * the `link`/`current_link` class strings below, which makes that global rule redundant — it has
 * been removed from `css/app.src.css` along with the CSS-discipline exception that named it, and
 * every arbitrary value here is replaced with the same token scale the theme's 14 scoped
 * components use (`w-7`/`h-7` for a 28px hit area, `px-inline`, `rounded-xs`, `gap-inline-xs`, `mt-stack`).
 */
#}
{% set link = 'inline-flex items-center justify-center min-w-7 h-7 px-inline rounded-xs border border-border-2 bg-surface-2 text-eyebrow text-text no-underline hover:bg-surface hover:border-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring' %}
{% set current_link = 'inline-flex items-center justify-center min-w-7 h-7 px-inline rounded-xs border border-primary bg-primary/15 text-eyebrow text-primary no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring' %}
{% set gap = 'inline-flex items-center justify-center min-w-7 h-7 text-eyebrow text-text-faint' %}
{% if items %}
  <nav class="bakers-pager pager flex w-full justify-center items-center gap-inline-xs mt-stack" role="navigation" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="sr-only">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items js-pager__items flex flex-wrap items-center gap-inline-xs m-0 p-0 list-none">
      {# Print first item if we are not on the first page. #}
      {% if items.first %}
        <li class="pager__item shrink-0 pager__item--first">
          <a href="{{ items.first.href }}" class="{{ link }}" title="{{ 'Go to first page'|t }}"{{ items.first.attributes|without('href', 'title') }}>
            <span class="sr-only">{{ 'First page'|t }}</span>
            <span aria-hidden="true">«</span>
          </a>
        </li>
      {% endif %}
      {# Print previous item if we are not on the first page. #}
      {% if items.previous %}
        <li class="pager__item shrink-0 pager__item--previous">
          <a href="{{ items.previous.href }}" class="{{ link }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
            <span class="sr-only">{{ 'Previous page'|t }}</span>
            <span aria-hidden="true">‹</span>
          </a>
        </li>
      {% endif %}
      {# Add an ellipsis if there are further previous pages. #}
      {% if ellipses.previous %}
        <li class="pager__item shrink-0 pager__item--ellipsis {{ gap }}" role="presentation">&hellip;</li>
      {% endif %}
      {# Now generate the actual pager piece. #}
      {% for key, item in items.pages %}
        <li class="pager__item shrink-0{{ current == key ? ' is-active' : '' }}">
          {% if current == key %}
            {% set title = 'Current page'|t %}
          {% else %}
            {% set title = 'Go to page @key'|t({'@key': key}) %}
          {% endif %}
          <a href="{{ item.href }}" class="{{ current == key ? current_link : link }}" title="{{ title }}"{{ item.attributes|without('href', 'title') }}>
            <span class="sr-only">{{ 'Page'|t }}</span>
            {{- key -}}
          </a>
        </li>
      {% endfor %}
      {# Add an ellipsis if there are further next pages. #}
      {% if ellipses.next %}
        <li class="pager__item shrink-0 pager__item--ellipsis {{ gap }}" role="presentation">&hellip;</li>
      {% endif %}
      {# Print next item if we are not on the last page. #}
      {% if items.next %}
        <li class="pager__item shrink-0 pager__item--next">
          <a href="{{ items.next.href }}" class="{{ link }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>
            <span class="sr-only">{{ 'Next page'|t }}</span>
            <span aria-hidden="true">›</span>
          </a>
        </li>
      {% endif %}
      {# Print last item if we are not on the last page. #}
      {% if items.last %}
        <li class="pager__item shrink-0 pager__item--last">
          <a href="{{ items.last.href }}" class="{{ link }}" title="{{ 'Go to last page'|t }}"{{ items.last.attributes|without('href', 'title') }}>
            <span class="sr-only">{{ 'Last page'|t }}</span>
            <span aria-hidden="true">»</span>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
