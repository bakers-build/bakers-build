{# The counter line-up beside the login card. The circles and the hairline are
   graphics in the station-* tokens and hidden from assistive technology; the
   roles and actions are the text a reader gets. #}
{# shortcut: no ui_patterns source supplies an array of objects, so the Island
   profile passes only the headline and the agreed station copy lives here; move
   it to config once a source for it exists. #}
{% set stations = stations ?: [
  {role: 'your client'|t, action: 'approves the plan'|t},
  {role: 'agents'|t, action: 'write the code'|t},
  {role: 'you'|t, action: 'decide what ships'|t, current: true},
] %}
<div{{ (attributes ?: create_attribute()).addClass(['flex', 'flex-col', 'gap-group', 'min-w-0']) }}>
  <h1 class="m-0 text-gate-headline font-display text-title text-balance">{{ headline }}</h1>
  <div aria-hidden="true" class="h-0 border-t border-dashed border-station-rule"></div>
  <ol class="m-0 p-0 list-none flex flex-col gap-group sm:flex-row sm:gap-section">
    {% for station in stations %}
      <li class="flex items-center gap-inline min-w-0"{% if station.current %} aria-current="step"{% endif %}>
        <span aria-hidden="true" class="shrink-0 size-10 rounded-full border-4 border-station-ring outline outline-1 outline-station-line {{ station.current ? 'bg-station-current' : 'bg-surface' }}"></span>
        <span class="flex flex-col min-w-0">
          <span class="text-body-strong text-text">{{ station.role }}</span>
          <span class="text-meta text-text-light">{{ station.action }}</span>
        </span>
      </li>
    {% endfor %}
  </ol>
</div>
