{# General action control with an optional leading icon slot. Renders an anchor
   when `href` is set and a button otherwise, so a navigational action and a
   scripted one share one contract. Distinct from `submit`, which is form-bound.

   Four variants — `neutral` for authentication actions, `primary` for the
   dominant call to action, `ghost` for icon-only controls, and `danger`, a
   quiet OUTLINE in the semantic danger role for an intervention that stops or
   ends work (Cancel ticket, Cancel run). Danger is outline only: a filled red
   button would out-shout the screen it sits on, and an intervention is
   exceptional, not dominant.

   `tone` tints a control with the same token pairs as `badge` (wait, attention,
   running, critical, idle). Board filter chips use it so several selected chips
   stay distinguishable; the label still names the value, colour is not the
   only signal. An icon-only control sets `icon_only`, which moves the
   label into `aria-label` so the control keeps an accessible name. #}
{% set is_link = href is defined and href %}
{% set tag = is_link ? 'a' : 'button' %}
{% set variant_classes = {
  'neutral': ['bg-surface', 'text-text', 'border', 'border-border', 'hover:bg-surface-2'],
  'primary': ['bg-primary', 'text-on-primary', 'border', 'border-transparent', 'hover:opacity-90'],
  'ghost': ['bg-transparent', 'text-text-light', 'border', 'border-transparent', 'hover:bg-surface-3', 'hover:text-text'],
  'danger': ['bg-transparent', 'text-state-unassigned-ink', 'border', 'border-state-unassigned', 'hover:bg-state-unassigned-tint'],
} %}
{% set tone_classes = {
  'wait': ['bg-state-unassigned-tint', 'text-state-unassigned-ink', 'border', 'border-state-unassigned', 'hover:opacity-90'],
  'critical': ['bg-state-unassigned-tint', 'text-state-unassigned-ink', 'border', 'border-state-unassigned', 'hover:opacity-90'],
  'attention': ['bg-state-attention-tint', 'text-state-attention-ink', 'border', 'border-state-attention-mark', 'hover:opacity-90'],
  'running': ['bg-state-running-tint', 'text-state-running-ink', 'border', 'border-state-running', 'hover:opacity-90'],
  'idle': ['bg-surface-3', 'text-text-light', 'border', 'border-border', 'hover:bg-surface-2'],
} %}
{% set tone_key = tone|default('') %}
{% set color_classes = tone_classes[tone_key]|default(variant_classes[variant|default('primary')]|default(variant_classes['primary'])) %}
{% set is_icon_only = icon_only|default(false) %}
{# The `[&.htmx-request]` utilities are a spinner while htmx.org marks this
   control busy; they live here, not in app.src.css, because token-discipline's
   check 5 reserves that file for Twig-unreachable cascade fixes. #}
<{{ tag }}{{ (attributes ?: create_attribute()).addClass([
    'button', 'inline-flex', 'items-center', 'justify-center', 'gap-[6px]',
    'h-[30px]', is_icon_only ? 'w-[30px] px-0' : 'px-[10px]', 'rounded-sm',
    'text-body-strong', 'no-underline', 'cursor-pointer',
    'focus-visible:outline-2', 'focus-visible:outline-offset-2', 'focus-visible:outline-focus-ring',
    'disabled:opacity-60', 'disabled:cursor-not-allowed',
    '[&.htmx-request]:cursor-progress', '[&.htmx-request]:opacity-60',
    '[&.htmx-request]:after:inline-block',
    '[&.htmx-request]:after:ml-inline-xs', '[&.htmx-request]:after:w-3', '[&.htmx-request]:after:h-3',
    '[&.htmx-request]:after:rounded-full', '[&.htmx-request]:after:border-2',
    '[&.htmx-request]:after:border-current', '[&.htmx-request]:after:border-r-transparent',
    '[&.htmx-request]:after:animate-[spin_0.6s_linear_infinite]',
  ]|merge(color_classes)) }}
  {%- if is_link %} href="{{ href }}"{% else %} type="{{ type|default('button') }}"{% endif %}
  {%- if disabled and not is_link %} disabled{% endif %}
  {%- if is_icon_only and label %} aria-label="{{ label }}"{% endif %}>
  {%- block icon %}{% if icon %}{{ icon }}{% endif %}{% endblock %}
  {%- if label and not is_icon_only %}<span class="button__label">{{ label }}</span>{% endif %}
</{{ tag }}>
