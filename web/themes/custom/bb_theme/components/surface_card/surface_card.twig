{# A generic lifted panel: optional header over a divider, then content.
   Same surface classes as `inspector`'s `surface` variant, factored out for a
   second panel of `canvas.inspector` (BB-661). #}
{%- set header_content %}{% block header %}{% if header %}{{ header }}{% endif %}{% endblock %}{% endset %}
{%- set body_content %}{% block content %}{% if content %}{{ content }}{% endif %}{% endblock %}{% endset %}
<div{{ (attributes ?: create_attribute()).addClass(['surface-card', 'w-full', 'flex', 'flex-col', 'p-4', 'bg-surface', 'border', 'border-border-2', 'rounded-sm']) }}>
  {%- if header_content|trim is not empty %}
  <div class="flex flex-col pb-4 mb-4 border-b border-border-2">{{ header_content }}</div>
  {%- endif %}
  <div class="flex flex-col gap-2">{{ body_content }}</div>
</div>
