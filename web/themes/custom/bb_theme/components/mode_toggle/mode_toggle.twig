{# The native popover owns dismissal, Escape and focus return. The mode lives on html; js/skin.src.js keeps the choice. #}
{% set initial = mode|default('system') in ['light', 'dark'] ? mode : 'system' %}
{# The panel opens beside its button: up from the rail's footer (start), or down from a page corner (end). #}
{% set panel_position = align|default('start') == 'end' ? 'right-4 top-14' : 'left-4 bottom-12' %}
<div{{ (attributes ?: create_attribute()).addClass(['inline-flex', 'shrink-0']) }}
  x-data="{ choice: '{{ initial }}' }"
  x-init="if (window.bakersModeChoice) choice = window.bakersModeChoice()"
  @bakers-appearance.window="if ($event.detail.choice) choice = $event.detail.choice"
  x-id="['appearance']">
  <button type="button" data-mode-toggle
    :popovertarget="$id('appearance')"
    :aria-controls="$id('appearance')"
    aria-label="{{ label|default('Choose appearance') }}"
    class="inline-grid place-items-center w-7 h-7 shrink-0 rounded-full bg-transparent border-0 text-text-faint cursor-pointer transition-colors duration-fast hover:bg-surface-3 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">
    {{ include('bb_theme:icon', { name: 'sun-moon', size: 'md' }, with_context = false) }}
  </button>
  <div popover="auto" x-ref="panel" :id="$id('appearance')" aria-label="Appearance"
    class="fixed inset-auto {{ panel_position }} m-0 max-w-full p-group rounded-md border border-control-border bg-surface text-text">
    <fieldset class="flex flex-col gap-inline m-0 p-0 border-0">
      <legend class="mb-inline p-0 text-label">Appearance</legend>
      {% for value, title in { light: 'Light', dark: 'Dark', system: 'System' } %}
        <label class="flex items-center gap-inline text-body cursor-pointer">
          <input type="radio" value="{{ value }}" :name="$id('appearance') + '-choice'"{% if value == initial %} checked{% endif %}
            :checked="choice === '{{ value }}'" @change="window.bakersSetMode('{{ value }}')"
            class="m-0 accent-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">
          <span>{{ title }}</span>
        </label>
      {% endfor %}
    </fieldset>
  </div>
</div>
