{# A Chart.js widget: the plot is painted in the browser. The markup carries the model and nothing drawn: stat-comparison.src.js
   reads `data-stat-comparison` and paints the canvas, reading each series colour from
   the `--color-chart-series-*` custom property so the plot follows the colour
   mode. The model rides in a data attribute rather than a `<script>` block on purpose —
   `|e('html_attr')` is EXPLICIT and not decoration: `json_encode` returns markup the
   autoescaper leaves alone, so without it the quotes land raw in the attribute and the
   parser shreds the payload into stray attributes. With it, a label can never close the
   element it sits in.

   `rows` IS NOT CALLED `entries`, and the name is load-bearing: Twing's `json_encode`
   duck-types a Map by calling `thing.entries()`, so a plain object carrying a key of
   that name makes the whole story fail to render with `thing.entries is not a function`.

   THE LEGEND AND THE EXACT-VALUE DISCLOSURE ARE MARKUP, not canvas. A canvas is one
   opaque bitmap to a screen reader, to a text search and to a contract script, so the
   values stay readable beside it rather than only inside it. #}
<section{{ (attributes ?: create_attribute()).addClass(['min-w-0', 'flex', 'flex-col', 'gap-4', 'py-4']).setAttribute('data-component-id', 'bb_theme:stat-comparison') }}>
  <h2 class="m-0 text-section font-semibold text-title">{{ chart.label }}</h2>
  {% if chart.state != 'ready' %}
    <p class="m-0 text-body text-text">No comparison values for this period.</p>
  {% else %}
    <div class="relative w-full h-72" data-stat-comparison="{{ chart|json_encode|e('html_attr') }}">
      <canvas class="block w-full h-full" role="img" aria-label="{{ chart.label }}"></canvas>
    </div>
    <ul class="flex flex-wrap gap-4 list-none p-0 m-0 text-caption text-text">
      {% set swatch = { a: 'bg-chart-series-a', b: 'bg-chart-series-b', c: 'bg-chart-series-c', d: 'bg-chart-series-d', e: 'bg-chart-series-e', f: 'bg-chart-series-f' } %}
      {% for series in chart.series %}
        <li class="flex items-center gap-2">
          <span class="inline-block w-3 h-3 rounded-full {{ swatch[series.style] }}" aria-hidden="true"></span>
          <span>{{ series.label }}{% if series.latest_value is not null %} {{ series.latest_value }}{% endif %}</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if chart.rows %}
    <details class="text-caption text-text-light">
      <summary class="w-fit cursor-pointer rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">Exact values</summary>
      <ul class="mt-2 p-0 m-0 list-none text-caption text-text">
        {% for row in chart.rows %}
          <li>{{ row.date }}{% for series in chart.series %} · {{ series.label }} {{ row.values[loop.index0] }}{% endfor %}</li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</section>
