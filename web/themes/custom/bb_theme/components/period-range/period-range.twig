{# Period switch for a statistics page: kind menu, previous/next around the
   period label (which opens a picker), "Return to this <kind>" and the
   comparison text. Dates are computed and labelled by the Alpine component
   `periodRange` (period-range.src.js); the server formats nothing.

   It is a GET form. With `action` every navigation submits it; without one
   (Storybook) the control only updates in place. The hidden inputs carry the
   initial values so the form is correct before Alpine starts. #}
{% set prefix = name|default('filter') %}
{% set initial_open = open is empty or open == 'none' ? null : open %}
{% set config = {
  kind: kind,
  date: date|default(null),
  start: start|default(null),
  end: end|default(null),
  today: today|default(null),
  open: initial_open,
  submit: action is not empty,
} %}
{% set focus_ring = 'focus-visible:outline-2 focus-visible:outline-focus-ring' %}
{% set popover = 'absolute left-0 top-full mt-1 z-30 flex flex-col gap-2 p-3 bg-surface border border-border rounded-md shadow-shadow-2' %}

{#- Previous / next period, around the range control and the custom fields. #}
{% set prev_button %}
{{ include('bb_theme:button', {
  label: 'Previous period',
  variant: 'ghost',
  icon_only: true,
  icon: include('bb_theme:icon', { name: 'arrow-left', size: 'sm' }, with_context = false),
  attributes: create_attribute({ 'x-bind:aria-label': 'prevLabel', 'x-on:click': 'step(-1)' }),
}, with_context = false) }}
{% endset %}
{% set next_button %}
{{ include('bb_theme:button', {
  label: 'Next period',
  variant: 'ghost',
  icon_only: true,
  icon: include('bb_theme:icon', { name: 'arrow-right', size: 'sm' }, with_context = false),
  attributes: create_attribute({ 'x-bind:aria-label': 'nextLabel', 'x-bind:disabled': 'nextDisabled', 'x-on:click': 'step(1)' }),
}, with_context = false) }}
{% endset %}

{#- Previous / heading / next of every picker. Week and custom calendars step
    by month, the month, quarter and year pickers by year. #}
{% set picker_header %}
  <div class="flex items-center justify-between gap-2">
    {{ include('bb_theme:button', {
      label: 'Previous month',
      variant: 'ghost',
      icon_only: true,
      icon: include('bb_theme:icon', { name: 'arrow-left', size: 'sm' }, with_context = false),
      attributes: create_attribute({
        'x-on:click': 'viewStep(-1)',
        'x-bind:aria-label': "open === 'picker' && kind !== 'week' ? 'Previous year' : 'Previous month'",
      }),
    }, with_context = false) }}
    <span class="text-body font-medium text-title" x-text="viewLabel"></span>
    {{ include('bb_theme:button', {
      label: 'Next month',
      variant: 'ghost',
      icon_only: true,
      icon: include('bb_theme:icon', { name: 'arrow-right', size: 'sm' }, with_context = false),
      attributes: create_attribute({
        'x-on:click': 'viewStep(1)',
        'x-bind:aria-label': "open === 'picker' && kind !== 'week' ? 'Next year' : 'Next month'",
      }),
    }, with_context = false) }}
  </div>
{% endset %}

{#- One month of ISO-week rows. In the week picker (open === 'picker') it shows
    the CW column and any day selects its whole week; in the custom from/to
    calendars it picks one day into the draft. #}
{#- A custom calendar's chosen day, and any cell drawn on primary (that day, or the selected week row). #}
{% set chosen = "(open === 'from' && cell.value === draft.start) || (open === 'to' && cell.value === draft.end)" %}
{% set on_primary = "(" ~ chosen ~ ") || (open === 'picker' && row.selected)" %}
{% set day_calendar %}
  <div role="grid" class="flex flex-col gap-1" x-on:keydown="moveFocus($event, 7)">
    <div role="row" class="grid" x-bind:class="open === 'picker' ? 'grid-cols-8' : 'grid-cols-7'">
      <span role="columnheader" class="flex items-center justify-center h-6 text-meta text-text-light" x-show="open === 'picker'">CW</span>
      {%- for weekday in ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'] %}
      <span role="columnheader" class="flex items-center justify-center h-6 text-meta text-text-light">{{ weekday }}</span>
      {%- endfor %}
    </div>
    <template x-for="row in weeks" x-bind:key="row.start">
      <div role="row" class="grid rounded-sm"
        x-bind:class="[open === 'picker' ? 'grid-cols-8' : 'grid-cols-7', open === 'picker' && row.selected ? 'bg-primary text-on-primary' : 'text-text']">
        <span role="rowheader" class="flex items-center justify-center h-8 text-meta"
          x-show="open === 'picker'"
          x-bind:class="row.selected ? 'text-on-primary' : 'text-text-light'"
          x-text="row.week"></span>
        <template x-for="(cell, index) in row.cells" x-bind:key="index">
          <div role="gridcell" class="flex items-center justify-center">
            <template x-if="cell">
              <button type="button"
                class="size-8 rounded-sm text-body cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed {{ focus_ring }}"
                x-bind:class="[({{ chosen }}) ? 'bg-primary text-on-primary' : (({{ on_primary }}) ? '' : 'hover:bg-surface-2'), cell.today ? 'ring-1 ' + (({{ on_primary }}) ? 'ring-on-primary' : 'ring-border') : '']"
                x-bind:disabled="open === 'picker' ? row.disabled : cell.disabled"
                x-bind:aria-current="cell.today ? 'date' : null"
                x-bind:aria-pressed="open === 'picker' ? null : String({{ chosen }})"
                x-bind:aria-label="dayLabel(cell.value)"
                x-bind:tabindex="dayTabindex(cell.value)"
                x-on:click="pickDay(cell.value)"
                x-text="cell.day"></button>
            </template>
          </div>
        </template>
      </div>
    </template>
  </div>
{% endset %}

<form{{ (attributes ?: create_attribute()).addClass(['period-range', 'relative', 'flex', 'flex-wrap', 'items-center', 'gap-2']) }}
  method="get"
  action="{{ action }}"
  x-data="periodRange({{ config|json_encode|escape('html_attr') }})"
  x-on:keydown.escape="close()"
  x-on:click.outside="close()">
  <input type="hidden" name="{{ prefix }}[period]" value="{{ kind }}" x-bind:value="kind">
  <input type="hidden" name="{{ prefix }}[date]" value="{{ date }}" x-bind:value="range.start">
  <input type="hidden" name="{{ prefix }}[start]" value="{{ start }}" x-bind:value="kind === 'custom' ? range.start : ''">
  <input type="hidden" name="{{ prefix }}[end]" value="{{ end }}" x-bind:value="kind === 'custom' ? range.end : ''">
  {%- for param in params ?? [] %}
  <input type="hidden" name="{{ param.name }}" value="{{ param.value }}">
  {%- endfor %}

  {#- Kind menu. Not option_picker: each row shows the live current period of
      its kind, which a server-rendered option list cannot recompute. #}
  <div class="relative">
    <button type="button"
      class="inline-flex items-center gap-1.5 h-8 px-3 bg-surface border rounded-sm text-body font-medium text-title cursor-pointer {{ focus_ring }}"
      x-ref="kindTrigger"
      aria-haspopup="listbox"
      x-bind:aria-expanded="open === 'kind'"
      x-bind:class="open === 'kind' ? 'border-focus-ring' : 'border-control-border'"
      x-on:click="toggle('kind')"
      {#- ArrowDown on the trigger opens the menu and enters it at its first row. #}
      x-on:keydown.down.prevent="open === 'kind' || toggle('kind'); $nextTick(() => $refs.kindList.querySelector('button').focus())">
      <span x-text="kindLabel(kind)"></span>
      {{ include('bb_theme:icon', { name: 'chevron-down', size: 'xs' }, with_context = false) }}
    </button>
    <div role="listbox" aria-label="Period kind" x-ref="kindList"
      class="absolute left-0 top-full mt-1 z-30 w-44 flex flex-col gap-0.5 p-1.5 bg-surface border border-border rounded-md shadow-shadow-2"
      x-cloak
      x-show="open === 'kind'"
      x-on:keydown="moveFocus($event, 1)">
      <template x-for="value in kinds" x-bind:key="value">
        <button type="button" role="option"
          class="flex items-center justify-between gap-3 px-2.5 py-2 rounded-xs text-left cursor-pointer hover:bg-surface-2 {{ focus_ring }}"
          x-bind:class="kind === value ? 'bg-surface-3 font-medium' : ''"
          x-bind:aria-selected="String(kind === value)"
          x-on:click="setKind(value)">
          <span class="text-body text-title" x-text="kindLabel(value)"></span>
          <span class="text-meta text-text-light" x-text="kindHint(value)"></span>
        </button>
      </template>
    </div>
  </div>

  {#- Range control: previous · picker trigger · next; All time shows static text. #}
  <div class="relative" x-show="kind !== 'custom'">
    <div class="inline-flex items-center h-8 bg-surface border rounded-sm"
      x-bind:class="open === 'picker' ? 'border-focus-ring' : 'border-control-border focus-within:border-focus-ring'">
      <template x-if="kind === 'all'">
        <span class="px-3 text-body font-medium text-title">All time</span>
      </template>
      <span class="contents" x-show="kind !== 'all'">
        {{ prev_button }}
        <button type="button"
          class="inline-flex items-center gap-1.5 h-full px-2 text-body font-medium text-title cursor-pointer {{ focus_ring }}"
          x-ref="pickerTrigger"
          aria-haspopup="dialog"
          x-bind:aria-expanded="open === 'picker'"
          x-on:click="toggle('picker')">
          {{ include('bb_theme:icon', { name: 'calendar', size: 'sm' }, with_context = false) }}
          <span x-text="label"></span>
        </button>
        {{ next_button }}
      </span>
    </div>
    <div role="dialog" class="{{ popover }}"
      x-cloak
      x-show="open === 'picker' && kind !== 'all'"
      x-bind:aria-label="'Choose a ' + kind"
      x-bind:class="kind === 'year' ? 'w-60' : 'w-72'">
      {{ picker_header }}
      <div x-show="kind === 'week'">{{ day_calendar }}</div>
      <template x-if="kind === 'month'">
        <div class="grid grid-cols-3 gap-1" x-on:keydown="moveFocus($event, 3)">
          <template x-for="cell in cells" x-bind:key="cell.range.start">
            <button type="button"
              class="h-8 rounded-sm text-body cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed {{ focus_ring }}"
              x-bind:class="[cell.selected ? 'bg-primary text-on-primary' : 'text-text hover:bg-surface-2', cell.today ? 'ring-1 ' + (cell.selected ? 'ring-on-primary' : 'ring-border') : '']"
              x-bind:disabled="cell.disabled"
              x-bind:aria-current="cell.today ? 'date' : null"
              x-bind:aria-pressed="String(cell.selected)"
              x-on:click="pick(cell.range)"
              x-text="cell.label"></button>
          </template>
        </div>
      </template>
      <template x-if="kind === 'quarter'">
        <div class="grid grid-cols-2 gap-1" x-on:keydown="moveFocus($event, 2)">
          <template x-for="cell in cells" x-bind:key="cell.range.start">
            <button type="button"
              class="flex flex-col items-center gap-0.5 py-2 rounded-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed {{ focus_ring }}"
              x-bind:class="[cell.selected ? 'bg-primary text-on-primary' : 'text-text hover:bg-surface-2', cell.today ? 'ring-1 ' + (cell.selected ? 'ring-on-primary' : 'ring-border') : '']"
              x-bind:disabled="cell.disabled"
              x-bind:aria-current="cell.today ? 'date' : null"
              x-bind:aria-pressed="String(cell.selected)"
              x-on:click="pick(cell.range)">
              <span class="text-body font-medium" x-text="cell.label"></span>
              <span class="text-meta" x-bind:class="cell.selected ? 'text-on-primary' : 'text-text-light'" x-text="cell.sub"></span>
            </button>
          </template>
        </div>
      </template>
      <template x-if="kind === 'year'">
        <div class="flex flex-col gap-0.5" x-on:keydown="moveFocus($event, 1)">
          <template x-for="cell in cells" x-bind:key="cell.range.start">
            <button type="button"
              class="w-full h-8 px-3 rounded-sm text-left text-body cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed {{ focus_ring }}"
              x-bind:class="[cell.selected ? 'bg-primary text-on-primary' : 'text-text hover:bg-surface-2', cell.today ? 'ring-1 ' + (cell.selected ? 'ring-on-primary' : 'ring-border') : '']"
              x-bind:disabled="cell.disabled"
              x-bind:aria-current="cell.today ? 'date' : null"
              x-bind:aria-pressed="String(cell.selected)"
              x-on:click="pick(cell.range)"
              x-text="cell.label"></button>
          </template>
        </div>
      </template>
    </div>
  </div>

  {#- Custom: ‹ From [date] to [date] › · Apply · day count. The fields are
      buttons styled as inputs, each opening a one-month day calendar; the
      arrows move the committed range by its own length. #}
  <div class="relative flex items-center gap-2" x-cloak x-show="kind === 'custom'">
    {{ prev_button }}
    <span class="text-body text-text-light">From</span>
    <button type="button"
      class="inline-flex items-center h-8 px-3 bg-input border border-control-border rounded-sm text-body text-text cursor-pointer {{ focus_ring }}"
      x-ref="fromTrigger"
      aria-haspopup="dialog"
      x-bind:aria-expanded="open === 'from'"
      x-bind:aria-label="fieldLabel('from')"
      x-on:click="toggle('from')"
      x-text="formatField(draft.start)"></button>
    <span class="text-body text-text-light">to</span>
    <button type="button"
      class="inline-flex items-center h-8 px-3 bg-input border border-control-border rounded-sm text-body text-text cursor-pointer {{ focus_ring }}"
      x-ref="toTrigger"
      aria-haspopup="dialog"
      x-bind:aria-expanded="open === 'to'"
      x-bind:aria-label="fieldLabel('to')"
      x-on:click="toggle('to')"
      x-text="formatField(draft.end)"></button>
    {{ next_button }}
    {{ include('bb_theme:button', {
      label: 'Apply',
      variant: 'primary',
      attributes: create_attribute({ 'x-bind:disabled': 'applyDisabled', 'x-on:click': 'apply()' }),
    }, with_context = false) }}
    <span class="text-meta text-text-light" x-text="dayCount"></span>
    <div role="dialog" class="{{ popover }} w-72"
      x-cloak
      x-show="open === 'from' || open === 'to'"
      x-bind:aria-label="open === 'from' ? 'Choose the first day' : 'Choose the last day'">
      {{ picker_header }}
      {{ day_calendar }}
    </div>
  </div>

  <button type="button"
    class="text-body font-medium text-link cursor-pointer {{ focus_ring }}"
    x-cloak
    x-show="canReturn"
    x-on:click="returnToCurrent()"
    x-text="returnLabel"></button>
  <span class="text-meta text-text-light" x-show="comparisonLabel" x-text="comparisonLabel"></span>
</form>
