{# Shared state-flow bar. `states` is the ordered workflow states (from the
   entity's state_machine workflow — never hard-coded here); `current` is
   highlighted. The colour/dot map covers every state id bakers.build's workflows
   define (bb_core.workflows.yml); unknown ids fall back to a neutral tone. #}
{% set state_color_map = {
  'plan': 'text-state-lease',
  'claimed': 'text-state-lease',
  'working': 'text-state-running',
  'running': 'text-state-running',
  'review': 'text-state-attention',
  'done': 'text-state-running',
  'cancelled': 'text-text-faint'
} %}
{% set state_dot_map = {
  'plan': 'bg-state-lease',
  'claimed': 'bg-state-lease',
  'working': 'bg-state-running',
  'running': 'bg-state-running',
  'review': 'bg-state-attention',
  'done': 'bg-state-running',
  'cancelled': 'bg-text-faint'
} %}
{% if states %}
  <nav class="flex items-center gap-[4px] flex-wrap py-[2px]" aria-label="{{ label|default('Workflow state flow') }}">
    {% for step in states %}
      {% set is_current = step == current %}
      <span class="inline-flex items-center gap-[5px] h-[22px] px-[9px] rounded-full text-eyebrow font-semibold whitespace-nowrap {{ is_current ? 'bg-surface-3 ' ~ state_color_map[step]|default('text-text-light') : 'text-text-faint' }}">
        <span class="inline-block w-[6px] h-[6px] rounded-full {{ is_current ? state_dot_map[step]|default('bg-text-light') : 'bg-border' }}" aria-hidden="true"></span>
        {{ step }}
      </span>
      {% if not loop.last %}<span class="text-text-faint" aria-hidden="true">›</span>{% endif %}
    {% endfor %}
  </nav>
{% endif %}
