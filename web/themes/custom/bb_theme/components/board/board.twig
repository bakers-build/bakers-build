{# A board: its controls, the active filters, ONE bounded scroll region of
   columns, and the conductors below it. The board owns its columns: data
   `columns` and the rendered Views column displays both draw their chrome
   through the `column()` macro below, which a Views template reaches with
   `{% import 'bb_theme:board' as board %}` as `list` reaches `table.cell()`.

   The region is the only sideways scroll area. It is bounded to the viewport
   below the board chrome (`max-h-board-height`), so a long column scrolls inside
   it and the column headers stick to its top. Native scrolling only: Shift +
   wheel scrolls it sideways without a script. It reaches 16 px into the page
   gutters (`-mx-group`) and its row spans the columns (`w-fit min-w-full`), so
   each edge has room for a hairline that sticks while columns are cut off on
   that side; the hairline's pseudo element sits just outside the region and
   casts the shadow-2 token in the faint text colour (`shadow-text-faint`),
   which contrasts with every surface in both modes: a shade in light mode, a
   glow in dark mode. A cover of the page surface at each end of the row hides
   hairline and shadow once that end is in view. The region carries the page
   surface itself, so the covers match it wherever the board is placed. #}
{% import _self as board %}

{% macro column(c) %}
  {% set dot_map = {
    'running': 'bg-state-running',
    'attention': 'bg-state-attention',
    'wait': 'bg-state-unassigned',
    'idle': 'bg-state-offline',
  } %}
  {% set nested = c.nested|default(false) %}
  {% set group = c.group|default(false) %}
  {% set terminal = c.terminal|default(false) %}
  {% set collapsed = c.collapsed|default(false) %}
  {#- A group grows like a lane but never below its nested columns (no
      min-w-0: its minimum is their min-content). -#}
  {% set width = collapsed ? ['shrink-0', 'min-w-0'] : (group ? ['flex-1', 'shrink-0'] : ['flex-1', 'basis-60', 'min-w-60', 'shrink-0']) %}
  {#- The column stretches to the row's height, so its sticky header stays at
      the top of the scroll region while a taller neighbour scrolls. It draws
      nothing itself: the header carries the top of its surface and the body
      the rest, so the surface still ends after the last card. A group's body
      grows with the column, so its state headers stick below its header. -#}
  {% set head = nested
    ? ['bg-surface-2', 'rounded-t-xs']
    : (terminal ? ['bg-surface', 'border-x', 'border-t', 'border-dashed', 'border-border', 'rounded-t-md'] : ['bg-surface-2', 'rounded-t-md']) %}
  {% set body = nested
    ? ['gap-inline', 'px-inline-xs', 'pb-inline-xs', 'bg-surface-2', 'rounded-b-xs']
    : (terminal ? ['gap-inline', 'px-inline', 'pb-inline', 'border-x', 'border-b', 'border-dashed', 'border-border', 'rounded-b-md'] : ['gap-inline', 'px-inline', 'pb-inline', 'bg-surface-2', 'rounded-b-md']) %}
  {#- Tags are stripped before the test: debug comments around an empty
      Views result are not cards. -#}
  {% set has_content = c.content is defined and c.content|render|striptags('<img><svg><input>')|trim is not empty %}
  <section{{ (c.attributes ?: create_attribute()).addClass(['flex', 'flex-col', 'self-stretch']|merge(width)).setAttribute('data-col', c.label).setAttribute('data-count', c.count|default(0)) }}>
    {% if nested %}
      <h3 class="sticky top-row z-10 flex items-baseline gap-inline m-0 px-inline pt-inline-xs pb-inline {{ head|join(' ') }}">
        <span class="font-mono text-data text-text">{{ c.label }}</span>
        <span class="text-meta text-text-light">{{ c.count|default(0) }}</span>
      </h3>
    {% else %}
      <h2 class="sticky top-0 z-10 flex items-center m-0 min-h-row px-inline {{ head|join(' ') }}">
        <span class="flex flex-wrap items-center gap-x-inline gap-y-inline-xs px-inline-xs">
          <span class="size-2 shrink-0 rounded-full {{ dot_map[c.tone|default('neutral')]|default('bg-border') }}" aria-hidden="true"></span>
          <span class="text-section-title text-title">{{ c.label }}</span>
          <span class="text-meta text-text-light">{{ c.count|default(0) }}</span>
          {% for hint in c.hints|default([]) %}
            <span class="text-meta text-text-light"><span aria-hidden="true">· </span>{{ hint }}</span>
          {% endfor %}
        </span>
      </h2>
    {% endif %}
    <div class="flex flex-col {{ group ? 'flex-1' : '' }} pt-inline-xs {{ body|join(' ') }}">
      {% if c.caption|default('') is not empty %}
        <p class="m-0 px-inline-xs text-meta text-text-light">{{ c.caption }}</p>
      {% endif %}
      {% if not collapsed %}
        {% if has_content %}
          <div class="flex {{ group ? 'flex-1 flex-row' : 'flex-col min-w-0' }} gap-inline">{{ c.content }}</div>
        {% elseif c.empty is defined and c.empty is not empty %}
          <div class="px-inline py-group text-meta text-text-light">{{ c.empty }}</div>
        {% endif %}
      {% endif %}
      {% if c.pager is defined and c.pager is not empty %}{{ c.pager }}{% endif %}
      {% if c.toggles|default([]) is not empty %}
        <div class="flex flex-wrap gap-inline">
          {% for toggle in c.toggles %}
            {{ include('bb_theme:button', { label: toggle.label, href: toggle.url, variant: 'neutral' }, with_context = false) }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endmacro %}

{% set states = ['plan', 'working', 'review'] %}
{#- What an empty data column says is the caller's sentence (the empty
    slot); without one the column keeps only its header and count. -#}
{% set empty_markup %}{% if empty is not empty %}{{ empty }}{% endif %}{% endset %}
<div{{ (attributes ?: create_attribute()).addClass(['flex', 'flex-col', 'gap-stack', 'min-w-0']).setAttribute('data-component-id', 'bb_theme:board') }}>
  {% if toolbar is not empty %}<div class="min-w-0">{{ toolbar }}</div>{% endif %}
  {% if filters_active is not empty %}<div class="min-w-0">{{ filters_active }}</div>{% endif %}
  <div class="relative min-w-0 -mx-group max-h-board-height overflow-auto bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring" tabindex="0" role="region" aria-label="Board columns">
    <div class="relative flex w-fit min-w-full gap-group pb-inline">
      <span class="sticky left-0 z-20 w-px -mr-px shrink-0 self-stretch pointer-events-none bg-border before:absolute before:inset-y-0 before:right-full before:w-4 before:shadow-shadow-2 before:shadow-text-faint/40" aria-hidden="true"></span>
      <span class="absolute inset-y-0 left-0 z-30 w-group pointer-events-none bg-surface" aria-hidden="true"></span>
      {% if column_views is not empty %}
        {{ column_views }}
      {% else %}
        {% for column in columns|default([]) %}
          {% set cards = column.cards|default([]) %}
          {% if details|default(false) and column.name == 'Working' %}
            {% set hints = [] %}
            {% for state in states %}
              {% if cards|filter(card => card.state|default('') == state) is empty %}{% set hints = hints|merge(['empty: ' ~ state]) %}{% endif %}
            {% endfor %}
            {% set sub %}
              {% for state in states %}
                {% set state_cards = cards|filter(card => card.state|default('') == state) %}
                {% if state_cards is not empty %}
                  {% set state_content %}{% for card in state_cards %}{{ include('bb_theme:board-card', card, with_context = false) }}{% endfor %}{% endset %}
                  {{ board.column({ label: state, count: state_cards|length, nested: true, content: state_content }) }}
                {% endif %}
              {% endfor %}
            {% endset %}
            {{ board.column({ label: column.name, count: column.count|default(cards|length), tone: column.dot|default('neutral'), group: true, hints: hints, content: sub }) }}
          {% else %}
            {% set done = column.name == 'Done' %}
            {% set column_content %}{% for card in cards %}{{ include('bb_theme:board-card', card, with_context = false) }}{% endfor %}{% endset %}
            {{ board.column({ label: column.name, count: column.count|default(cards|length), tone: column.dot|default('neutral'), caption: column.caption|default(''), toggles: column.toggles|default([]), terminal: done, collapsed: done and not done_open|default(false), content: column_content, empty: empty_markup }) }}
          {% endif %}
        {% endfor %}
      {% endif %}
      {#- The row ends 16 px after the last column, in the gutter the region
          reaches into, so the last column ends where the toolbar does. The
          hairline sits 4 px inside that gap and its 4 px pseudo element ends on
          the row's edge, so neither widens the scroll range; the cover spans
          the gap and hides both at the end. -#}
      <span class="sticky right-0 z-20 w-px -ml-1 -mr-px shrink-0 self-stretch pointer-events-none bg-border after:absolute after:inset-y-0 after:left-full after:-ml-px after:w-1 after:shadow-shadow-2 after:shadow-text-faint/80" aria-hidden="true"></span>
      <span class="relative z-30 w-group -ml-7 shrink-0 self-stretch pointer-events-none bg-surface" aria-hidden="true"></span>
    </div>
  </div>
  {% if conductors is not empty %}<div class="min-w-0">{{ conductors }}</div>{% endif %}
</div>
