{#
   Lean multi-line text input; the textarea counterpart of form_input. Unlike
   an <input>, a <textarea>'s content is its TEXT NODE, not a `value` attribute
   — printed with no surrounding whitespace, since whitespace inside the tag
   becomes part of the field's value.
#}
<textarea{{ (attributes ?: create_attribute()).addClass([
    'input', 'w-full', 'px-[11px]', 'py-[8px]', 'bg-app', 'border', 'border-control-border',
    'rounded-sm', 'text-text', 'text-body', 'focus:outline-none', 'focus:border-primary',
  ]) }}
  {%- if id %} id="{{ id }}"{% endif %}
  {%- if name %} name="{{ name }}"{% endif %}
  {%- if rows %} rows="{{ rows }}"{% endif %}
  {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
  {%- if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}
  {%- if required %} required{% endif %}>{{- value -}}</textarea>
