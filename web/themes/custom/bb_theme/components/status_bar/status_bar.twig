{# Bottom bar of the shell, filling the page `footer` slot. Deliberately not
   called `footer` and without a navigation slot: it is a status surface, not a
   site footer. The refresh slot sits on the left; its wrapper is OUTSIDE the
   {% block %} so filling the slot replaces the content, never the wrapper. #}
<div{{ (attributes ?: create_attribute()).addClass([
    'flex', 'min-w-0', 'overflow-hidden', 'items-center', 'gap-2', 'h-control', 'px-3',
    'bg-app', 'border-t', 'border-border', 'text-meta', 'text-text-light',
  ]) }}
  data-status-bar>
  {%- if label %}<span class="min-w-0 truncate">{{ label }}</span>{% endif %}
  <span class="flex items-center justify-start flex-1 min-w-0 overflow-hidden">{% block refresh %}{% if refresh %}{{ refresh }}{% endif %}{% endblock %}</span>
</div>
