{# Square crop control of one image upload. The image field widget's presenter
   (image-widget--bb-square-image.html.twig) passes the props and three slots:
   `upload` (the field's own file input), `remove` (core's Remove button, only
   when a saved file exists) and `rest` (hidden values, optional alt/title).
   Behaviour is the registered Alpine component `imageCrop`
   (image_crop.src.js); every x-ref and binding below is its contract.

   Two states, both server-rendered: without `src` a placeholder avatar with the
   user icon and "Choose picture"; with `src` the staged square as the avatar,
   "Edit crop" and "Choose another" (or Remove for a saved file). The file input
   stays in the document, visually hidden: its label is the visible button, so
   choosing works without JavaScript and keyboard focus lands on the real input
   (shown on the label through `peer-has-[:focus-visible]`).

   The dialog is a native <dialog> opened with showModal(), not the `dialog`
   component: the top layer puts it above an open create dialog, and without a
   `data-dialog` hook island's Escape handler never sees it. `m-auto` restores
   the user agent's centring, which Tailwind's preflight margin reset removes.
   `image-orientation: none` shows raw pixels, the same the server crops. #}
{% set dialog_id = id|default('bakers-image-crop') %}
{% set title_id = dialog_id ~ '__title' %}
{% set has_image = src is not empty %}
{% set edit_attributes = create_attribute({
  'x-ref': 'edit',
  'x-on:click': 'open()',
  'x-bind:hidden': '!src',
}) %}
{% if not has_image %}{% set edit_attributes = edit_attributes.setAttribute('hidden', true) %}{% endif %}
<div{{ (attributes ?: create_attribute()).addClass(['flex', 'flex-col', 'gap-3']) }}
  x-data="imageCrop"
  data-image-crop
  data-src="{{ src }}"
  data-width="{{ width }}"
  data-height="{{ height }}"
  data-crop="{{ crop|e('html_attr') }}">
  <div class="flex items-center gap-4">
    <span class="relative grid place-items-center w-20 h-20 shrink-0 overflow-hidden rounded-full border border-border bg-surface-2 text-text-faint">
      <span class="grid place-items-center" x-bind:hidden="!!src"{% if has_image %} hidden{% endif %}>
        {{ include('bb_theme:icon', { name: 'user', size: 'xl' }, with_context = false) }}
      </span>
      <img alt="" draggable="false" class="absolute max-w-none" style="image-orientation: none"{% if has_image %} src="{{ src }}"{% else %} hidden{% endif %} x-bind:hidden="!src" x-bind:src="src" x-bind:style="frame(staged, 80)" />
    </span>
    <div class="flex flex-col gap-2 min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        {% if input_id %}
          <span class="sr-only peer">{{ upload }}</span>
          <label for="{{ input_id }}" class="inline-flex items-center justify-center h-[30px] px-[10px] rounded-sm border border-border bg-surface text-text text-caption font-bold cursor-pointer hover:bg-surface-2 peer-has-[:focus-visible]:outline-2 peer-has-[:focus-visible]:outline-offset-2 peer-has-[:focus-visible]:outline-primary">
            <span x-text="src ? 'Choose another' : 'Choose picture'">{{ has_image ? 'Choose another' : 'Choose picture' }}</span>
          </label>
        {% elseif upload %}
          <span class="sr-only">{{ upload }}</span>
        {% endif %}
        {{ include('bb_theme:button', {
          label: 'Edit crop',
          variant: 'neutral',
          attributes: edit_attributes.setAttribute('aria-description', label),
        }, with_context = false) }}
        {% if remove %}{{ remove }}{% endif %}
      </div>
      {% if hint %}<p class="m-0 text-caption text-text-light">{{ hint }}</p>{% endif %}
    </div>
  </div>
  {% if rest %}{{ rest }}{% endif %}
  <dialog x-ref="dialog" aria-labelledby="{{ title_id }}" x-on:cancel.prevent="close()" x-on:keydown.escape.stop
    class="m-auto w-[360px] max-w-[calc(100vw-32px)] max-h-[calc(100vh-32px)] overflow-y-auto p-0 rounded-md border border-border bg-surface text-text shadow-lg backdrop:bg-text/40">
    <div class="flex items-center h-[44px] px-[16px] border-b border-border-2">
      <h2 id="{{ title_id }}" class="m-0 text-heading font-bold text-title">Crop image</h2>
    </div>
    <div class="flex flex-col gap-3 px-[16px] py-[14px]">
      <div x-ref="viewport" role="img" aria-label="Image to crop" tabindex="0"
        class="relative w-full aspect-square overflow-hidden touch-none cursor-move select-none rounded-sm bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        x-on:pointerdown="startPan($event)" x-on:pointermove="pan($event)" x-on:pointerup="endPan()" x-on:pointercancel="endPan()" x-on:keydown="nudge($event)">
        <img alt="" draggable="false" class="absolute max-w-none pointer-events-none" style="image-orientation: none" x-bind:src="src" x-bind:style="frame(draft, viewport)" />
      </div>
      <p class="m-0 text-caption text-text-light">Drag the image or use the arrow keys to frame it.</p>
      <label class="flex items-center gap-3 text-body text-text">
        Zoom
        <input type="range" min="1" max="4" step="0.01" class="flex-1 accent-primary" x-bind:max="maxZoom" x-model.number="zoom" x-on:input="zoomTo()" />
      </label>
    </div>
    <div class="flex items-center justify-end gap-[8px] px-[16px] py-[12px] border-t border-border-2">
      {{ include('bb_theme:button', { label: 'Reset', variant: 'ghost', attributes: create_attribute({ 'x-on:click': 'reset()' }) }, with_context = false) }}
      {{ include('bb_theme:button', { label: 'Cancel', variant: 'ghost', attributes: create_attribute({ 'x-on:click': 'close()' }) }, with_context = false) }}
      {{ include('bb_theme:button', { label: 'Apply', variant: 'primary', attributes: create_attribute({ 'x-on:click': 'apply()' }) }, with_context = false) }}
    </div>
  </dialog>
</div>
