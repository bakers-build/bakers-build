{# Form label. Default = uppercase field label above a text input; `inline` = the
   plain label text used to the right of a checkbox/radio. `title_display: invisible`
   hides the label visually while keeping it for screen readers. #}
{% set vis = title_display|default('before') %}
{% set label_classes = inline
  ? ['label', 'text-meta', 'text-text-light', 'cursor-pointer', 'select-none']
  : ['label', 'block', 'text-eyebrow', 'font-semibold', 'uppercase', 'tracking-[0.03em]', 'text-state-offline', 'mb-[6px]'] %}
{% if vis == 'invisible' %}{% set label_classes = label_classes|merge(['sr-only']) %}{% endif %}
<label{{ (attributes ?: create_attribute()).addClass(label_classes) }}{% if for %} for="{{ for }}"{% endif %}>{% if title %}{{ title }}{% endif %}</label>
