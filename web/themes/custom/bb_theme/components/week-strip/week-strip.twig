{# Seven day links and the week total. Links work with JavaScript off; the
   selected day is aria-current="date". Narrow screens keep one row of seven
   compact cells (weekday initial + total); the accessible name of each link
   carries the full day sentence. #}
<nav{{ (attributes ?: create_attribute()).addClass([
    'week-strip', 'flex', 'w-full', 'min-w-0', 'items-stretch', 'gap-2',
  ]) }}
  aria-label="{{ label }}">
  <ul class="m-0 grid min-w-0 flex-1 list-none grid-cols-7 gap-1 p-0">
    {%- for day in days %}
      {%- set is_active = day.active|default(false) %}
      {%- set is_zero = day.total == '0:00' %}
      <li class="min-w-0">
        <a
          class="flex min-w-0 flex-col items-center gap-1 rounded-sm border px-1 py-2 text-center no-underline
            {{ is_active
              ? 'border-primary bg-surface text-title shadow-sm'
              : 'border-border bg-surface-2 text-text hover:border-primary' }}"
          href="{{ day.url }}"
          aria-label="{{ day.aria_label }}"
          {%- if is_active %} aria-current="date"{% endif %}>
          <span class="text-meta font-medium" aria-hidden="true">
            <span class="sm:hidden">{{ day.weekday|first }}</span>
            <span class="max-sm:hidden">{{ day.weekday }} {{ day.date }}</span>
          </span>
          <span class="text-body font-semibold tabular-nums {{ is_zero ? 'text-text-faint' : '' }}" aria-hidden="true">{{ day.total }}</span>
        </a>
      </li>
    {%- endfor %}
  </ul>
  <p class="m-0 flex shrink-0 flex-col items-end justify-center gap-1 text-right">
    <span class="text-meta text-text-faint">{{ total_label }}</span>
    <span class="text-body font-semibold tabular-nums text-title">{{ total }}</span>
  </p>
</nav>
