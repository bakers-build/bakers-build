{# Generic two-position panel switcher. This wrapper owns `{ selected }` so a
   caller passes slots rather than Alpine or layout classes. The filter is
   shrink-wrapped (`self-start`); each panel stacks its content. Nested x-data
   on the control would shadow `selected` and break switching. #}
{% set first_value = items[0].value|default('') %}
{% set second_value = items[1].value|default('') %}
{% set selected_js = (selected|default(first_value))|json_encode %}
<div{{ (attributes ?: create_attribute()).addClass(['flex', 'flex-col', 'gap-stack']) }}
  x-data='{ selected: {{ selected_js }} }'>
  <div class="self-start">
    {{ include('bb_theme:segmented_control', {
      label: filter_label,
      state: 'selected',
      items: items,
    }, with_context = false) }}
  </div>
  {% block intro %}{{ intro }}{% endblock %}
  <div class="flex flex-col gap-inline" x-show='selected === {{ first_value|json_encode }}'>
    {% block panel_a %}{{ panel_a }}{% endblock %}
  </div>
  <div class="flex flex-col gap-inline" x-show='selected === {{ second_value|json_encode }}'>
    {% block panel_b %}{{ panel_b }}{% endblock %}
  </div>
  {% block after %}{{ after }}{% endblock %}
</div>
