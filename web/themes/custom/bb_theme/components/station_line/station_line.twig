{# The production line, drawn from the homepage's station icons, as a quiet
   eight-second loop: a dough ball hops into the scale (which sinks a little
   under it), through the oven (two puffs of steam, out comes a bun), under the
   magnifier (one thoughtful tilt), until a person's cursor clicks to approve,
   a small spark, and the bun hops off the line.

   Decoration only, so it is hidden from assistive technology. Every motion is
   SMIL on one shared clock (`dur` 8s, `keyTimes` as fractions of it), because
   SMIL needs no CSS of its own. SMIL cannot be paused from CSS, so the moving
   scene and a still one are two groups and the motion query picks one: with
   reduced motion the stations stand still and the finished bun waits at the
   end. The still group uses `motion-safe:hidden`, not `hidden`, because core's
   own `.hidden` would always win. Outlines follow `currentColor`. #}
{% set line = '/themes/custom/bb_theme/assets/line/' %}
{% set clock = 'dur="8s" repeatCount="indefinite"' %}
<svg{{ (attributes ?: create_attribute()).addClass(['station-line', 'block', 'w-full', 'h-auto', 'overflow-hidden']).setAttribute('aria-hidden', 'true').setAttribute('focusable', 'false').setAttribute('viewBox', '0 0 440 76') }}>
  <g class="motion-reduce:hidden">
    {# The bun: drawn round its centre, so it can grow and spin in place. #}
    <g>
      <animateTransform attributeName="transform" type="translate" {{ clock|raw }}
        keyTimes="0;0.06;0.12;0.20;0.27;0.34;0.48;0.55;0.62;0.80;0.87;0.95;1"
        values="-20 49;16 43;52 49;52 49;136 43;220 49;220 49;304 43;388 49;388 49;425 41;470 49;470 49"/>
      <g>
        <animateTransform attributeName="transform" type="scale" {{ clock|raw }}
          keyTimes="0;0.40;0.48;1" values="0.7;0.7;1;1"/>
        <image href="{{ file_url(line ~ 'step-bun.svg') }}" x="-13" y="-13" width="26" height="26"/>
      </g>
    </g>

    {# The scale sinks a little under the weight. #}
    <g>
      <animateTransform attributeName="transform" type="translate" {{ clock|raw }}
        keyTimes="0;0.12;0.15;0.20;0.23;1" values="0 0;0 0;0 2;0 2;0 0;0 0"/>
      <image href="{{ file_url(line ~ 'step-scale.svg') }}" x="30" y="18" width="44" height="44"/>
    </g>

    {# The oven bakes it: two puffs of steam. #}
    <image href="{{ file_url(line ~ 'step-oven.svg') }}" x="198" y="18" width="44" height="44"/>
    {% for puff in [{x: 214, at: 0.37}, {x: 226, at: 0.41}] %}
      <path d="M{{ puff.x }} 14q3 -3 0 -6q-3 -3 0 -6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0">
        <animate attributeName="opacity" {{ clock|raw }} keyTimes="0;{{ puff.at }};{{ puff.at + 0.04 }};{{ puff.at + 0.10 }};1" values="0;0;1;0;0"/>
        <animateTransform attributeName="transform" type="translate" {{ clock|raw }} keyTimes="0;{{ puff.at }};{{ puff.at + 0.10 }};1" values="0 4;0 4;0 -8;0 -8"/>
      </path>
    {% endfor %}

    {# The magnifier tilts once, thinks, and straightens. #}
    <g>
      <animateTransform attributeName="transform" type="rotate" {{ clock|raw }}
        keyTimes="0;0.62;0.65;0.70;0.73;1" values="0 388 52;0 388 52;-8 388 52;-8 388 52;0 388 52;0 388 52"/>
      <image href="{{ file_url(line ~ 'step-magnifier.svg') }}" x="366" y="18" width="44" height="44"/>
    </g>

    {# A person decides: the cursor swoops in and clicks. #}
    <g opacity="0">
      <animate attributeName="opacity" {{ clock|raw }} keyTimes="0;0.69;0.71;0.82;0.85;1" values="0;0;1;1;0;0"/>
      <animateTransform attributeName="transform" type="translate" {{ clock|raw }}
        keyTimes="0;0.69;0.74;0.80;0.86;1" values="440 -10;440 -10;398 26;398 26;440 -10;440 -10"/>
      <g>
        <animateTransform attributeName="transform" type="scale" {{ clock|raw }} keyTimes="0;0.75;0.765;0.78;1" values="1;1;0.85;1;1"/>
        <image href="{{ file_url(line ~ 'cursor-pink.svg') }}" width="15" height="20"/>
      </g>
    </g>

    {# Approved: a spark. #}
    <g transform="translate(410 14)" opacity="0">
      <animate attributeName="opacity" {{ clock|raw }} keyTimes="0;0.76;0.78;0.86;1" values="0;0;1;0;0"/>
      <g>
        <animateTransform attributeName="transform" type="scale" {{ clock|raw }} keyTimes="0;0.76;0.80;0.86;1" values="0;0;1;0.8;0"/>
        <image href="{{ file_url(line ~ 'spark.svg') }}" x="-7" y="-7" width="14" height="14"/>
      </g>
    </g>
  </g>

  <g class="motion-safe:hidden">
    <image href="{{ file_url(line ~ 'step-scale.svg') }}" x="30" y="18" width="44" height="44"/>
    <image href="{{ file_url(line ~ 'step-oven.svg') }}" x="198" y="18" width="44" height="44"/>
    <image href="{{ file_url(line ~ 'step-magnifier.svg') }}" x="366" y="18" width="44" height="44"/>
    <image href="{{ file_url(line ~ 'step-bun.svg') }}" x="411" y="35" width="27" height="27"/>
  </g>

  <rect x="1" y="62" width="438" height="12" rx="6" class="fill-gate-counter" stroke="currentColor" stroke-width="2"/>
</svg>
