{# Lists keep their existing message, with one small decorative icon. #}
{% set error_page = (icon ~ '') in ['signpost-missing', 'signpost-denied'] %}
{% set state_classes = error_page
  ? ['flex', 'flex-col', 'items-center', 'justify-center', 'gap-3', 'text-center', 'text-text-light', 'min-w-0', 'py-6', 'px-4', 'border', 'border-dashed', 'border-border', 'rounded-sm']
  : ['flex', 'items-center', 'justify-center', 'gap-2', 'text-caption', 'text-text-faint', 'min-w-0'] %}
<div{{ (attributes ?: create_attribute()).addClass(state_classes) }}>
  {{ include('bb_theme:icon', {
    name: icon|default('inbox'),
    attributes: create_attribute().addClass([error_page ? 'size-empty-state-icon' : 'size-empty-state-compact-icon', 'shrink-0', error_page ? 'text-primary' : 'text-text-faint']),
  }, with_context = false) }}
  <p class="{{ error_page ? 'text-gate-body' : 'text-caption' }} max-w-prose wrap-break-word">{{ message }}</p>
</div>
