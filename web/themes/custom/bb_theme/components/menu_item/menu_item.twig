{# One link row of a disclosed menu panel (`role="menu"`), e.g. the
   workspace list in account_switcher's `workspace_panel`. The current row is
   bold and carries `aria-current`, so the open panel names where the reader
   already is instead of offering it as a second destination. An optional
   `mark` (the workspace's image or initials) leads the label and an optional
   `description` sits beneath it; without either, the row is the bare label. #}
<a{{ (attributes ?: create_attribute()).setAttribute('href', url).setAttribute('role', 'menuitem').addClass([
    'block', 'px-inline', 'py-inline-xs', 'rounded-xs', 'no-underline',
    'text-body', 'text-text',
    'hover:bg-surface-3', 'hover:text-text',
    'focus-visible:outline-2', 'focus-visible:outline-offset-2', 'focus-visible:outline-focus-ring',
    current ? 'font-bold' : '',
  ]|filter(c => c)) }}{% if current %} aria-current="true"{% endif %}>
  {%- if mark or description -%}
    {#- A lone label centres beside its mark; with a description beneath, the mark aligns to the first line. #}
    <span class="flex min-w-0 {{ description ? 'items-start' : 'items-center' }} gap-inline">
      {%- if mark %}<span class="flex shrink-0">{{ include('bb_theme:person', { variant: 'compact', size: 'sm', initials: mark.initials|default(''), color: mark.color|default('running'), picture: mark.picture|default(''), image_fit: 'contain' }, with_context = false) }}</span>{% endif -%}
      <span class="flex min-w-0 flex-col">
        <span>{{ label }}</span>
        {%- if description %}<span class="font-normal text-meta text-text-faint wrap-anywhere whitespace-pre-line">{{ description }}</span>{% endif -%}
      </span>
    </span>
  {%- else -%}
    {{ label }}
  {%- endif -%}
</a>
