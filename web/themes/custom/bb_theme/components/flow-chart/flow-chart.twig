{# A Chart.js widget, built like stat-comparison: the markup carries the model in
   `data-flow-chart` (|e('html_attr') keeps quotes in a label from breaking the
   attribute) and flow-chart.src.js paints the canvas. Every word the canvas or
   the tooltip shows comes from here as markup or a data attribute, so the
   behaviour holds no copy. The tooltip and live region are filled by the
   behaviour; the legend and the exact-value disclosure are plain markup. #}
<section{{ (attributes ?: create_attribute()).addClass(['min-w-0', 'flex', 'flex-col', 'gap-group', 'py-group']).setAttribute('data-component-id', 'bb_theme:flow-chart') }}>
  <div class="flex flex-wrap items-baseline gap-x-inline gap-y-inline-xs">
    <h2 class="m-0 text-section-title text-title">{{ chart.label }}</h2>
    {% if chart.caption %}
      <p class="m-0 text-meta text-text-light">{{ chart.caption }}</p>
    {% endif %}
  </div>
  {% if chart.state != 'ready' %}
    <p class="m-0 text-body text-text">No flow values for this period.</p>
  {% else %}
    <div class="flex flex-col gap-inline">
      <p class="m-0 flex items-center justify-end gap-inline text-meta text-text-light">
        <span>{{ chart.ratio_label }}</span>
        <span class="text-body-strong text-title">{{ chart.ratio ?? '—' }}</span>
      </p>
      <div class="relative w-full h-72"
        data-flow-chart="{{ chart|json_encode|e('html_attr') }}"
        data-label-new="new"
        data-label-done="done"
        data-label-running="running"
        data-running-suffix=" · still running"
        data-open-running-label="Open at {{ chart.open_at }}">
        <canvas class="block w-full h-full rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring" role="img" tabindex="0" aria-label="{{ chart.label }}"></canvas>
        <div class="absolute top-0 left-0 z-10 min-w-40 flex flex-col gap-inline-xs rounded-sm bg-title px-stack py-inline text-surface pointer-events-none" data-flow-chart-tooltip hidden>
          <p class="m-0 text-body-strong" data-flow-chart-title></p>
          <dl class="m-0 flex flex-col gap-inline-xs">
            <div class="flex items-baseline justify-between gap-gutter">
              <dt class="text-label text-surface-3">Created</dt>
              <dd class="m-0 text-body-strong" data-flow-chart-value="new"></dd>
            </div>
            <div class="flex items-baseline justify-between gap-gutter">
              <dt class="text-label text-surface-3">Closed</dt>
              <dd class="m-0 text-body-strong" data-flow-chart-value="done"></dd>
            </div>
            <div class="flex items-baseline justify-between gap-gutter" data-flow-chart-open-row>
              <dt class="text-label text-surface-3" data-flow-chart-open-label>Open</dt>
              <dd class="m-0 text-body-strong" data-flow-chart-value="open"></dd>
            </div>
          </dl>
        </div>
        <p class="sr-only" aria-live="polite" data-flow-chart-live></p>
      </div>
    </div>
    <ul class="flex flex-wrap items-center gap-group list-none p-0 m-0 text-meta text-text">
      <li class="flex items-center gap-inline">
        <span class="inline-block w-4 h-0.5 rounded-xs bg-chart-flow-new" aria-hidden="true"></span>
        <span>new{% if chart.totals %} {{ chart.totals.new }}{% endif %}</span>
      </li>
      <li class="flex items-center gap-inline">
        <span class="inline-block w-4 h-0.5 rounded-xs bg-chart-flow-done" aria-hidden="true"></span>
        <span>done{% if chart.totals %} {{ chart.totals.done }}{% endif %}</span>
      </li>
      <li class="flex items-center gap-inline">
        <span class="inline-block w-2.5 h-2.5 rounded-xs bg-chart-flow-grows" aria-hidden="true"></span>
        <span>backlog grows</span>
      </li>
      <li class="flex items-center gap-inline">
        <span class="inline-block w-2.5 h-2.5 rounded-xs bg-chart-flow-shrinks" aria-hidden="true"></span>
        <span>backlog shrinks</span>
      </li>
    </ul>
    <details class="text-meta text-text-light">
      <summary class="w-fit cursor-pointer rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">Exact values</summary>
      <ul class="mt-inline p-0 m-0 list-none text-meta text-text">
        {% for section in chart.sections %}
          <li>{{ section.label }}{% if section.running %} · still running{% endif %} · Created {{ section.new }} · Closed {{ section.done }}{% if section.open is not null %} · {% if section.running and chart.open_at %}Open at {{ chart.open_at }}{% else %}Open{% endif %} {{ section.open }}{% endif %}</li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</section>
