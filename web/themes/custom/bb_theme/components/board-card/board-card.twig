{% set status_tone = { running: 'running', attention: 'attention', needs_input: 'attention', wait: 'wait', idle: 'neutral' } %}
{% set edge_map = {
  'running': 'before:bg-state-running',
  'attention': 'before:bg-state-attention-mark',
  'needs_input': 'before:bg-state-attention-mark',
  'wait': 'before:bg-state-unassigned'
} %}
{% set card_classes = ['relative', 'bg-surface', 'border', 'border-border-2', 'rounded-sm', 'p-inline', 'pl-stack', "before:content-['']", 'before:absolute', 'before:left-0', 'before:top-0', 'before:bottom-0', 'before:w-1', 'before:rounded-l-sm', edge_map[status]|default('before:bg-transparent')] %}
{% if status == 'wait' %}{% set card_classes = card_classes|merge(['bg-state-unassigned-tint']) %}{% endif %}
{# Colour by ticket type: normalise the bb_<type> workflow id to the short key. #}
{% set type_key = (type|default(''))|replace({'bb_': ''}) %}
{% set type_dot_map = {
  'feature': 'bg-type-feature',
  'bug': 'bg-type-bug',
  'chore': 'bg-type-chore'
} %}
<article{{ (attributes ?: create_attribute()).addClass(card_classes).setAttribute('data-state', state|default('')).setAttribute('data-type', type_key) }}>
  {% if url %}<a class="use-ajax absolute inset-0 z-10 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring" href="{{ url }}" data-dialog-type="dialog.off_canvas" data-dialog-options='{"width":"40%"}' aria-label="Open {{ identifier }}"></a>{% endif %}
  <div class="flex items-center gap-inline-xs mb-inline-xs">
    {% if type_dot_map[type_key] is defined %}<span class="inline-block w-2 h-2 rounded-full shrink-0 {{ type_dot_map[type_key] }}" title="{{ type_key }}" aria-label="{{ type_key }}"></span>{% endif %}
    <span class="font-mono text-data text-text">{{ identifier }}</span>
    <span class="flex-1"></span>
    {#- P1 is `critical`, not `wait`. Both draw the same red pair, so nothing moves on
        the screen; what changes is what the badge SAYS. `wait` means nobody is acting
        on this, which is false of a card somebody is working — the tone was borrowed
        for its colour while the token layer had no name for the red that ranks. #}
    {% if priority %}{{ include('bb_theme:badge', { label: priority|upper, tone: priority == 'p1' ? 'critical' : 'neutral' }, with_context = false) }}{% endif %}
  </div>
  <p class="text-item-title text-text m-0 line-clamp-2">{{ title }}</p>
  {#- Blocked names the open blockers the reader may see; a hidden blocker
      still blocks, so the marker then reads "Blocked by" alone. -#}
  {% set blockers = blocked_by|default([]) %}
  {% set is_blocked = blockers|length > 0 or blocked_hidden|default(false) %}
  {% if is_blocked or state == 'cancelled' %}
    <div class="flex flex-wrap gap-inline-xs mt-inline">
      {% if is_blocked %}<span class="inline-flex items-center gap-inline-xs px-inline py-inline-xs rounded-xs bg-surface-2 border border-border text-meta font-medium text-text"><span class="size-2 shrink-0 bg-state-unassigned-ink" aria-hidden="true"></span>Blocked by{% if blockers|length > 0 %} <span class="font-mono text-data">{{ blockers|join(', ') }}</span>{% endif %}</span>{% endif %}
      {% if state == 'cancelled' %}{{ include('bb_theme:badge', { label: 'Cancelled', tone: 'neutral' }, with_context = false) }}{% endif %}
    </div>
  {% endif %}
  {% set runs = run_count|default(0) %}
  {% if runs > 0 %}
    {% set alarm = last_run_state|default('') in ['failed', 'expired'] %}
    {% set run_dot = alarm ? 'bg-state-unassigned' : (last_run_state|default('') in ['running', 'claimed'] ? 'bg-state-running' : 'bg-text-faint') %}
    <div class="flex items-center gap-inline-xs mt-inline text-meta {{ alarm ? 'text-state-unassigned-ink' : 'text-text-light' }}"><span class="size-2 shrink-0 rounded-full {{ run_dot }}" aria-hidden="true"></span>{{ runs }} {{ runs == 1 ? 'run' : 'runs' }}{% if last_run_state|default('') is not empty %} - last {{ last_run_state }}{% endif %}</div>
  {% endif %}
  {% if footer %}
    <div class="relative z-20 flex items-center gap-inline-xs mt-inline">{{ footer }}</div>
  {% elseif done_label or mr_url %}
    {#- A done card says when it was done and links its merge request instead
        of the lease and state line. #}
    <div class="relative z-20 flex items-center gap-inline-xs mt-inline">
      {% if mr_url %}{{ include('bb_theme:text', {text: mr_label|default('MR'), href: mr_url, as: 'span', size: 'meta'}, with_context = false) }}{% endif %}
      {% if done_label %}<span class="text-meta text-text-light">{{ 'Done'|t }} {{ include('bb_theme:time', {label: done_label, datetime: done_datetime|default(''), title: done_title|default('')}, with_context = false) }}</span>{% endif %}
      {% if assignee_initials %}{{ include('bb_theme:person', {variant: 'compact', display_name: assignee_name, initials: assignee_initials, color: assignee_color|default('running')}, with_context = false) }}{% endif %}
    </div>
  {% elseif lease or state or assignee_initials %}
    <div class="relative z-20 flex items-center gap-inline-xs mt-inline">
      {% if lease %}{{ include('bb_theme:badge', {label: lease, tone: 'lease', mono: true, icon: 'lock'}, with_context = false) }}{% endif %}
      <span class="flex-1"></span>
      {% if state %}{{ include('bb_theme:badge', {label: state, tone: status_tone[status]|default('neutral'), dot: true}, with_context = false) }}{% endif %}
      {% if assignee_initials %}{{ include('bb_theme:person', {variant: 'compact', display_name: assignee_name, initials: assignee_initials, color: assignee_color|default('running')}, with_context = false) }}{% endif %}
    </div>
  {% endif %}
</article>
