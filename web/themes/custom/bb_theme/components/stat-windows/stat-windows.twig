{# One figure's three trailing totals (BB-481 D6/D7).

   Server-rendered, no JavaScript and no charting library: the caller has already resolved
   both the numbers and the words for them, so this template only lays them out. `value` is a
   STRING so the component never formats a number and can carry "0", "7" or an em-dash alike.

   The three periods are a fixed triple rather than an open list. A `windows` figure arriving
   with two periods would render a lopsided row instead of failing, and display_builder drops
   invalid props silently — so the schema requires exactly three and this template trusts it. #}
<section{{ (attributes ?: create_attribute()).addClass(['min-w-0', 'flex', 'flex-col', 'gap-5', 'py-group', 'border-b', 'border-border-2']) }}>
  <h2 class="m-0 text-section-title text-title">{{ label }}</h2>
  <dl class="m-0 grid grid-cols-3 gap-y-inline divide-x divide-border-2">
    {% for window in windows %}
      <div class="min-w-0 grid grid-rows-subgrid row-span-2 px-stack first:pl-0 last:pr-0">
        <dt class="text-label text-text-light">{{ window.label }}</dt>
        <dd class="m-0 text-stat-value text-title tabular-nums">{{ window.value }}</dd>
      </div>
    {% endfor %}
  </dl>
  {% if source %}
    <details class="text-meta text-text-light">
      <summary class="w-fit cursor-pointer rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">Data source</summary>
      <code class="block pt-inline font-mono text-data break-all">{{ source }}</code>
    </details>
  {% endif %}
</section>
