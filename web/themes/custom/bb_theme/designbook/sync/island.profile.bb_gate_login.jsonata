/* The login page's gate: bb_gate plus the station line-up in `aside`. Its
 * lower weight puts it ahead of bb_gate, which still lists /user/login. */
(
{
  "langcode": "en",
  "status": true,
  "dependencies": {
    "config": [
      "island.app.bakers"
    ],
    "enforced": {
      "config": [
        "island.app.bakers"
      ]
    },
    "module": [
      "island_ui_patterns",
      "ui_patterns"
    ],
    "theme": [
      "bb_theme"
    ]
  },
  "id": "bb_gate_login",
  "label": "bakers.build gate: login",
  "app": "bakers",
  "layout": "bb_theme:gate",
  "layout_settings": {
    "title": ""
  },
  "placements": {
    "gate_mark": {
      "plugin_id": "ui_patterns_component",
      "slot": "mark",
      "weight": 0,
      "enabled": true,
      "configuration": {
        "component": {
          "component_id": "bb_theme:brand",
          "variant_id": null,
          "props": {
            "size": {
              "source_id": "select",
              "source": {
                "value": "compact"
              }
            }
          },
          "slots": {}
        }
      },
      "data": {}
    },
    "gate_messages": {
      "plugin_id": "messages",
      "slot": "content",
      "weight": 0,
      "enabled": true,
      "configuration": {},
      "data": {}
    },
    "gate_main": {
      "plugin_id": "page_content",
      "slot": "content",
      "weight": 1,
      "enabled": true,
      "configuration": {},
      "data": {}
    },
    "gate_lineup": {
      "plugin_id": "ui_patterns_component",
      "slot": "aside",
      "weight": 0,
      "enabled": true,
      "configuration": {
        "component": {
          "component_id": "bb_theme:station_lineup",
          "variant_id": null,
          "props": {
            "headline": {
              "source_id": "textfield",
              "source": {
                "value": "You're the baker. Agents run the line."
              }
            }
          },
          "slots": {}
        }
      },
      "data": {}
    }
  },
  "weight": -11,
  "conditions": {
    "paths": [
      "/user/login"
    ]
  }
}
)
