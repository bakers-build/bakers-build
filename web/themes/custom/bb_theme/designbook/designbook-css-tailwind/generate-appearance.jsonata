/** @config
 {
   "input": "../design-system/design-tokens.yml",
   "output": "../../css/tokens/appearance.src.css"
 }
 */
(
  $join($each(themes, function($theme) {
    $exists($theme."$extensions".selector) ? (
      $colors := $each($theme.semantic.color, function($token, $name) {
        "  --color-" & $name & ": " & $token."$value" & ";"
      });
      $font := $theme.primitive.style.fontFamily.sans."$value";
      ":root" & $theme."$extensions".selector & " {\n" & $join($colors, "\n") &
      ($exists($font) ? "\n  --font-sans: " & $font & ";" : "") & "\n}"
    )
  }), "\n\n") & "\n"
)
