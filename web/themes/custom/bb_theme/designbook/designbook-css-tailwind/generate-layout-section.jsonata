/** @config
 {
   "input": "../design-system/design-tokens.yml",
   "output": "../../css/tokens/layout-section.src.css"
 }
 */

(
  /* --container-section sizes Tailwind's max-w-section. */
  $node := $reduce($split("component.section.max-width", "."), function($a, $s) { $lookup($a, $s) }, $$);
  $exists($node."$value")
    ? "@theme static {\n  --container-section: " & $node."$value" & ";\n}\n"
    : ""
)
