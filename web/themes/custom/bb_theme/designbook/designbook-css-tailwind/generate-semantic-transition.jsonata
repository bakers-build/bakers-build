/** @config
 {
   "input": "../design-system/design-tokens.yml",
   "output": "../../css/tokens/semantic-transition.src.css"
 }
 */

(
  $normalizeCssValue := function($val) {
    $type($val) = "string"
      ? $replace($replace($val, /(^|[\s:,])\.(\d)/, "$10.$2"), /(^|[\s:,])-\.(\d)/, "$1-0.$2")
      : $val
  };
  $resolveRef := function($val) {
    $substring($val, 0, 1) = "{" ? (
      $ref := $replace($replace($val, "{", ""), "}", "");
      $target := $reduce($split($ref, "."), function($a, $s) { $lookup($a, $s) }, $$);
      $normalizeCssValue($target."$value")
    ) : $normalizeCssValue($val)
  };
  $walk := function($node, $path) {
    $reduce(
      $keys($node),
      function($acc, $k) {
        $substring($k, 0, 1) != "$" ? (
          $v := $lookup($node, $k);
          $sub := $path = "" ? $k : $path & "-" & $k;
          $exists($v."$value")
            ? $append($acc, "  --transition-duration-" & $sub & ": " & $resolveRef($v."$value") & ";")
            : $append($acc, $walk($v, $sub))
        ) : $acc
      },
      []
    )
  };
  $node := $reduce($split("semantic.transition", "."), function($a, $s) { $lookup($a, $s) }, $$);
  $lines := $walk($node, "");
  $count($lines) > 0
    ? "@theme static {\n" & $join($lines, "\n") & "\n}\n"
    : ""
)
