/** @config
 {
   "input": "../design-system/design-tokens.yml",
   "output": "../../css/tokens/typography.src.css"
 }
 */

(
  $normalizeCssValue := function($val) {
    $type($val) = "string"
      ? $replace($replace($val, /(^|[\s:,])\.(\d)/, "$10.$2"), /(^|[\s:,])-\.(\d)/, "$1-0.$2")
      : $val
  };
  $resolve := function($val) {
    $substring($val, 0, 1) = "{" ? (
      $ref := $replace($replace($val, "{", ""), "}", "");
      $parts := $split($ref, ".");
      $typeKeywords := ["color","spacing","radius","fontFamily","fontSize","fontWeight","lineHeight","elevation","lineWeight","duration","focusRing","letterSpacing"];

      $matchIdxs := $filter($map($parts, function($p, $i) { $count($filter($typeKeywords, function($t) { $t = $p })) > 0 ? $i : -1 }), function($x) { $x >= 0 });


      $typeIdx := $count($matchIdxs) > 0 ? $matchIdxs[0] : -1;

      $rtype := $typeIdx >= 0 ? $parts[$typeIdx] : $parts[1];

      $primPrefix := $rtype = "fontFamily" ? "font"

        : $rtype = "fontSize" ? "text"

        : $rtype = "fontWeight" ? "font-weight"

        : $rtype = "lineHeight" ? "leading"

        : $rtype = "focusRing" ? "focus-ring"

        : $rtype = "letterSpacing" ? "tracking"

        : $rtype;

      $suffixStart := $typeIdx >= 0 ? $typeIdx + 1 : 2;

      "var(--" & $primPrefix & "-" & $join($filter($parts, function($p, $i) { $i >= $suffixStart }), "-") & ")"
    ) : $normalizeCssValue($val)
  };
  $node := $reduce($split("semantic.typography", "."), function($a, $s) { $lookup($a, $s) }, $$);
  /* Component typography roles join as `<component>-<role>`, e.g. component.gate.body → --text-gate-body. */
  $componentRoles := $merge($each($$.component, function($group, $g) {
    $merge($each($group, function($v, $k) {
      $type($v) = "object" and $v."$type" = "typography" ? { $g & "-" & $k: $v } : {}
    }))
  }));
  $node := $merge([$node, $componentRoles]);
  $entries := $each($node, function($v, $k) {
    $substring($k, 0, 1) != "$" and $v."$type" = "typography" ? (
      $val := $v."$value";
      "  --text-" & $k & ": " & $resolve($val.fontSize) & ";\n" &
      "  --text-" & $k & "--font-weight: " & $resolve($val.fontWeight) & ";\n" &
      "  --text-" & $k & "--line-height: " & $resolve($val.lineHeight) & ";" &
      ($exists($val.letterSpacing) ? "\n  --text-" & $k & "--letter-spacing: " & $resolve($val.letterSpacing) & ";" : "")
    )
  });
  $lines := $filter($entries, function($e) { $e != null });
  $count($lines) > 0
    ? "@theme static {\n" & $join($lines, "\n") & "\n}\n"
    : ""
)