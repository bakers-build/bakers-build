(
  /* HAND-WRITTEN ONCE under a waiver: Pascal Glass, 2026-11-11 (BAKERS-55
     Task 12). Designbook a4fea9d7 map-entity refuses list-view mappings
     ("uses unsupported structure list-view") although drupal-views.md
     requires list-view for every view.

     THE PROJECT BOARD (views.view.project_board, page display): the filter
     bar, the active filters, the four work-state columns and the active
     conductors. The view record names the board state a scene shows; the
     tickets are pinned. Unhealthy tickets carry their reason; a blocked
     ticket waits in Intake and is never unhealthy. */
  $states := {
    "project_board": { "details": false, "done_open": false, "health": false },
    "project_board_details": { "details": true, "done_open": false, "health": false },
    "project_board_done_open": { "details": false, "done_open": true, "health": false },
    "project_board_unhealthy": { "details": false, "done_open": false, "health": true }
  };
  $s := $lookup($states, $exists($.id) ? $.id : "project_board");
  $people := {
    "cw": { "name": "Christian Wiedemann", "initials": "CW", "color": "attention" },
    "sg": { "name": "Sven Gruber", "initials": "SG", "color": "running" }
  };
  $tickets := [
    { "id": "BB-281", "type": "bug", "title": "Runs dispatch to the wrong agent: three conductors with divergent agent configs", "phase": "na", "state": "plan", "prio": "p1" },
    { "id": "BB-307", "type": "bug", "title": "Expired runs are never closed: 1333 stand open because no path closes them", "phase": "na", "state": "plan", "prio": "p1", "runs": 4, "last": "failed", "reason": "Last run failed" },
    { "id": "BB-312", "type": "bug", "title": "Billing account picker shows archived accounts", "phase": "na", "state": "qualification", "prio": "p2", "reason": "Needs info" },
    { "id": "BB-402", "type": "feature", "title": "Board: persist the Details toggle per user", "phase": "intake", "state": "qualification", "prio": "p1", "who": "cw", "blocked": ["BB-348"] },
    { "id": "BB-405", "type": "chore", "title": "Retire the Gin-era ticket components", "phase": "intake", "state": "qualification", "prio": "p2", "who": "cw", "hidden": true },
    { "id": "BB-398", "type": "bug", "title": "Conductor cannot reach the repository after the team move", "phase": "intake", "state": "qualification", "prio": "p1", "runs": 1, "last": "cancelled", "reason": "Conductor has no access" },
    { "id": "BB-393", "type": "bug", "title": "Conductor reap leaks worktree DDEV environments", "phase": "working", "state": "working", "prio": "p1", "who": "cw", "runs": 6, "last": "running", "live": true },
    { "id": "BB-365", "type": "bug", "title": "Deployment tickets ignore every project whose key is not bakers.build", "phase": "working", "state": "working", "prio": "p1", "who": "sg", "runs": 2, "last": "running", "live": true },
    { "id": "BB-348", "type": "bug", "title": "Ticket detail drops the handoff stream on reload", "phase": "working", "state": "plan", "prio": "p2", "who": "cw", "runs": 1, "last": "expired", "reason": "Last run expired" },
    { "id": "BB-390", "type": "bug", "title": "Import connector stalls on the staging data", "phase": "working", "state": "working", "prio": "p2", "who": "sg", "runs": 3, "last": "failed", "reason": "Technical problem" },
    { "id": "BB-344", "type": "bug", "title": "Settings form loses the repository branch", "phase": "working", "state": "working", "prio": "p3", "who": "sg", "runs": 2, "last": "done", "reason": "Idle 4 days" },
    { "id": "BB-371", "type": "feature", "title": "Show the source ticket in the Related pane", "phase": "done", "state": "done", "prio": "p1", "who": "cw", "closed": 2 },
    { "id": "BB-366", "type": "chore", "title": "Close expired runs from the reaper", "phase": "done", "state": "cancelled", "prio": "p1", "closed": 3 },
    { "id": "BB-350", "type": "feature", "title": "Seed the onboarding wizard with a first project", "phase": "done", "state": "done", "prio": "p2", "who": "sg", "closed": 5 },
    { "id": "BB-301", "type": "feature", "title": "Move the board summary into the page header", "phase": "done", "state": "done", "prio": "p3", "who": "cw", "closed": 20 }
  ];
  $url := "/?path=/story/designbook-sections-tickets-scenes--ticket-detail";
  $card := function ($t) {(
    $p := $t.who ? $lookup($people, $t.who);
    {
      "identifier": $t.id,
      "title": $t.title,
      "type": "bb_" & $t.type,
      "url": $url,
      "state": $t.state,
      "status": $t.live ? "running" : "idle",
      "priority": $t.prio,
      "assignee_name": $p.name,
      "assignee_initials": $p.initials,
      "assignee_color": $p.color,
      "blocked_by": $t.blocked,
      "blocked_hidden": $t.hidden,
      "run_count": $t.runs,
      "last_run_state": $t.last,
      "done_label": $t.closed ? $t.closed & " days ago"
    }
  )};
  $open := $tickets[phase != "done"];
  $visible := $s.health ? $open[reason] : $open;
  $done := $s.health ? [] : $tickets[phase = "done" and closed <= 7];
  $cards := function ($phase) { [$map($visible[phase = $phase], $card)] };
  $toggles := $s.done_open
    ? [{ "label": "Show older", "url": "?done=show&done_older=1" }, { "label": "Hide done", "url": "?done=hide" }]
    : [{ "label": "Show done", "url": "?done=show" }];
  $assignee := function ($who) {
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:button",
      "props": {
        "variant": "ghost",
        "label": $string($count($open[who = $who])),
        "href": "?assignee[]=" & $who,
        "pressed": false,
        "aria_label": $lookup($people, $who).name & ", " & $count($open[who = $who]) & " tickets"
      },
      "slots": {
        "icon": [{
          "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:person",
          "props": { "variant": "compact", "initials": $lookup($people, $who).initials, "color": $lookup($people, $who).color, "display_name": "" }
        }]
      }
    }
  };
  $picker := function ($field, $label, $icon, $value, $options) {
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:option_picker",
      "props": { "variant": "field", "label": $label, "icon": $icon, "value_label": $value, "aria_label": "Filter by " & $field & ". Currently " & $value & ".", "multiple": true, "name": $field, "id": "board-" & $field },
      "slots": {
        "options": [{
          "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:option_list",
          "props": { "name": $field, "multiple": true, "options": [$map($options, function ($o) { { "value": $o, "label": $o, "count": $string($count($open[state = $o or prio = $o])) } })] }
        }]
      }
    }
  };
  [{
    "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:board",
    "props": {
      "details": $s.details,
      "done_open": $s.done_open,
      "columns": [
        { "name": "Not assigned", "dot": "wait", "cards": $cards("na") },
        { "name": "Intake", "dot": "attention", "cards": $cards("intake") },
        { "name": "Working", "dot": "running", "cards": $cards("working") },
        { "name": "Done", "dot": "idle", "count": $count($done), "caption": $s.done_open ? "last 7 days", "toggles": $toggles, "cards": [$map($done, $card)] }
      ]
    },
    "slots": {
      "empty": "No ticket matches these filters.",
      "toolbar": [{
        "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:filters",
        "props": { "layout": "toolbar", "label": "Board filters" },
        "slots": {
          "controls": [
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_input", "props": { "type": "search", "name": "search", "id": "board-search", "value": "", "placeholder": "Search tickets", "compact": true } },
            $picker("state", "State", "status-running", "All", ["plan", "qualification", "working"]),
            $picker("priority", "Priority", "alert-triangle", "All", ["p1", "p2", "p3"]),
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:text", "props": { "text": "Assignee", "as": "span", "size": "meta", "tone": "light" } },
            $assignee("cw"),
            $assignee("sg"),
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:button", "props": { "variant": "neutral", "label": "Unassigned · " & $count($open[$not($exists(who))]), "href": "?assignee[]=!", "pressed": false } }
          ],
          "actions": [
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:text", "props": { "text": "Details", "as": "span", "size": "meta", "tone": "light" } },
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:segmented_control", "props": { "label": "Details", "items": [
              { "label": "Phases", "url": "?details=phases", "active": $not($s.details) },
              { "label": "States", "url": "?details=states", "active": $s.details }
            ] } },
            { "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:button", "props": { "variant": "ghost", "label": "Clear filters", "href": "?" } }
          ]
        }
      }],
      "filters_active": [{
        "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:active-filters",
        "props": {
          "variant": "inline",
          "label": "Active filters",
          "empty_label": "No filters",
          "facets": $s.health ? [{ "field": "Unhealthy", "count": $count($visible), "remove_url": "?" }] : []
        },
        "slots": {
          "meta": [{ "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:text", "props": { "text": $count($visible) & " of " & $count($open) & " open tickets", "as": "span", "size": "meta", "tone": "light" } }]
        }
      }],
      "conductors": [{ "entity": "view.conductors", "view_mode": "board" }]
    }
  }]
)
