(
  /* THE ADDONS LISTING (Workspace Settings › Addons): `bb_theme:list` whose `rows` slot holds each
     addon in its `list_item` view mode, as Drupal's `bb_rows` style renders `views.view.addons`.
     The row's look (the person mark of the definition's icon or initials, label and name,
     "Versions" and "Contract", the conductors running any version) lives in
     `bb_addon.bb_addon.list_item.jsonata`, not here.

     The view lists every addon name once, at its newest version. A view mapping takes no record,
     so it names those records itself, in the view's sort, name ascending: bare@1.0.0 (no
     conductor in this workspace) and ports@1.2.3 (two conductors, one per version). The empty
     text "No addon is registered yet." is not rendered while rows exist. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_addon", "bundle": "bb_addon", "view_mode": "list_item", "record": 2 },
          { "type": "entity", "entity_type": "bb_addon", "bundle": "bb_addon", "view_mode": "list_item", "record": 0 }
        ]
      }
    }
  ]
)
