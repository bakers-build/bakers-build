(
  /* THE MACHINES LISTING: `bb_theme:list` whose `rows` slot holds each machine in its `list_item`
     view mode, as Drupal's `bb_rows` style renders `views.view.machines`. The row's look (linked
     name, parallel-slot and load badges, Owner, "Last run") lives in
     `bb_machine.bb_machine.list_item.jsonata`, not here.

     A view mapping takes no record, so it names the listed records itself: both machines, owned
     by the URL account (user 1), in the view's sort, name ascending. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_machine", "bundle": "bb_machine", "view_mode": "list_item", "record": 0 },
          { "type": "entity", "entity_type": "bb_machine", "bundle": "bb_machine", "view_mode": "list_item", "record": 1 }
        ]
      }
    }
  ]
)
