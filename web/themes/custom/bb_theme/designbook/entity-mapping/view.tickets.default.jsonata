(
  /* THE TICKETS LISTING: `bb_theme:list` whose `rows` slot holds each ticket in its `list_item`
     view mode, as Drupal's `bb_rows` style renders the default display of `views.view.tickets`
     (My work renders `list_item_mine`). The row's look (state mark, linked title, priority,
     identifier, "Created", "by" owner, conductor lease, stall reason, run summary, assignee mark,
     accent rail) lives in `bb_ticket.bb_ticket.list_item.jsonata`, not here.

     A view mapping takes no record, so it names the listed records itself: the eight open leaf
     tickets the listing has always shown, in the view's sort, last changed first. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 0 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 6 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 8 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 7 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 9 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 10 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 4 },
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item", "record": 3 }
        ]
      }
    }
  ]
)
