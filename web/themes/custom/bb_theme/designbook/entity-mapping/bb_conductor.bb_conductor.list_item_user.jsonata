(
  $fields := $;
  [
    {
      "component": "bb_theme:list_item",
      "slots": {
        "headline": { "component": "bb_theme:list_cell", "props": {"key": "label", "primary": true, "fallback": "(unnamed)"}, "slots": { "value": $fields.label } },
        "meta": [
          { "component": "bb_theme:list_cell", "props": {"key": "status"}, "slots": { "value": { "component": "bb_theme:badge", "props": { "dot": true, "tone": $fields.status_tone, "label": $fields.status_label } } } },
          { "component": "bb_theme:list_cell", "props": {"key": "project_id", "caption": "Project"}, "slots": { "value": $fields.project_label } }
        ],
        "right": { "component": "bb_theme:list_cell", "props": {"key": "reported_load", "align": "end", "fallback": "—"}, "slots": { "value": { "component": "bb_theme:badge", "props": { "icon": "run", "tone": "neutral", "label": $fields.reported_load } } } },
        "right_meta": [
          { "component": "bb_theme:list_cell", "props": {"key": "owner_user_id", "caption": "Owner"}, "slots": { "value": $fields.owner_label } },
          { "component": "bb_theme:list_cell", "props": {"key": "last_seen", "caption": "Last run"}, "slots": { "value": $fields.last_seen } }
        ]
      }
    }
  ]
)
