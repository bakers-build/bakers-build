(
  /* THE TICKETS ONE CONDUCTOR HOLDS: `bb_theme:list` whose `rows` slot holds each ticket in its
     `list_item_compact` view mode (identifier, linked title), as Drupal's `bb_rows` style renders
     `views.view.conductor_tickets`. A view mapping takes no record, so it names the listed record
     itself: BB-142, the one ticket conductor cw · framework holds. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_ticket", "bundle": "bb_ticket", "view_mode": "list_item_compact", "record": 0 }
        ]
      }
    }
  ]
)
