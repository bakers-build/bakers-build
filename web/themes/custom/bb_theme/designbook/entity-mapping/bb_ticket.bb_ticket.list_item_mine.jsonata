(
  $fields := $;
  [
    {
      "component": "bb_theme:list_item",
      "props": { "accent": $fields.row_accent },
      "slots": {
        "avatar": { "component": "bb_theme:list_cell", "props": { "key": "state" }, "slots": { "value": $fields.state_icon } },
        "headline": [
          { "component": "bb_theme:list_cell", "props": { "key": "title", "primary": true }, "slots": { "value": $fields.title } },
          { "component": "bb_theme:list_cell", "props": { "key": "priority" }, "slots": { "value": { "component": "bb_theme:badge", "props": { "tone": $fields.priority_tone, "label": $fields.priority_label } } } }
        ],
        "meta": [
          { "component": "bb_theme:list_cell", "props": { "key": "identifier" }, "slots": { "value": $fields.identifier_link } },
          { "component": "bb_theme:list_cell", "props": { "key": "created", "caption": "Created" }, "slots": { "value": $fields.created } },
          { "component": "bb_theme:list_cell", "props": { "key": "owner", "caption": "by" }, "slots": { "value": { "component": "bb_theme:person", "props": { "variant": "compact", "size": "sm", "initials": $fields.owner_initials, "color": $fields.owner_color, "display_name": $fields.owner_name } } } },
          { "component": "bb_theme:list_cell", "props": { "key": "stall_reason" }, "slots": { "value": { "component": "bb_theme:badge", "props": { "tone": "wait", "dot": true, "suffix": $fields.stall_suffix, "label": $fields.stall_reason } } } },
          { "component": "bb_theme:list_cell", "props": { "key": "run_summary" }, "slots": { "value": { "component": "bb_theme:badge", "props": { "tone": $fields.run_summary_tone, "icon": "run", "suffix": $fields.run_summary_suffix, "label": $fields.run_summary } } } }
        ],
        "right": { "component": "bb_theme:list_cell", "props": { "key": "conductor", "fallback": "—", "align": "end" }, "slots": { "value": { "component": "bb_theme:badge", "props": { "tone": "lease", "mono": true, "icon": "lock", "mine": $fields.conductor_mine, "label": $fields.conductor_label } } } }
      }
    }
  ]
)
