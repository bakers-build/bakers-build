(
  /* THE RUNS LISTING: `bb_theme:list` whose `rows` slot holds each run in its `list_item` view
     mode, as Drupal's `bb_rows` style renders `views.view.runs`. The row's look (the ticket
     identifier linking to the ticket, because a run has no detail surface; the state badge; "From";
     the conductor's lease badge, agent and "Started"; "Took" on the right, a faint em-dash when no
     duration was recorded) lives in `bb_run.bb_run.list_item.jsonata`, not here.

     A view mapping takes no record, so it names the listed records itself: the five runs of
     workspace 1 (run 4 is Northwind's), in the view's sort, newest start first, where the two
     runs that never started come last. Together they show every state the row distinguishes:
     running, failed, done, claimed and expired. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_run", "bundle": "bb_run", "view_mode": "list_item", "record": 2 },
          { "type": "entity", "entity_type": "bb_run", "bundle": "bb_run", "view_mode": "list_item", "record": 1 },
          { "type": "entity", "entity_type": "bb_run", "bundle": "bb_run", "view_mode": "list_item", "record": 0 },
          { "type": "entity", "entity_type": "bb_run", "bundle": "bb_run", "view_mode": "list_item", "record": 4 },
          { "type": "entity", "entity_type": "bb_run", "bundle": "bb_run", "view_mode": "list_item", "record": 5 }
        ]
      }
    }
  ]
)
