(
  /* THE GROUPS LISTING, AS A VIEW THAT RENDERS ONE LIST ROW PER GROUP (BB-592, field table revised
     with the operator). The mapping emits ONE `list` node whose `pattern` is the `bb_list` Views
     style's own pattern for `views.view.groups` — headline: linked group name; no meta line (v4,
     2026-10-03); right: the project count as an icon badge; right_meta: last update ("Updated"). Every row links
     to that group's own screen (scene `group-detail-overview`). A group grants no permissions, so there
     is no role column.

     A view address takes no record, so the row below MIRRORS `designbook/data/bb_group.bb_group.yml`
     by hand. ONE ROW: `Northwind Trading` belongs to workspace 2 and every screen in this section is
     scoped to workspace 1. The relative "Updated" value and the count are pinned.

     AVATAR AND DESCRIPTION (BB-597): `name_avatar` is the row's leading avatar — a compact `md`
     person cell from the `bb_entity_avatar` formatter: the group image uncropped
     (`image_fit: contain`) where one is set, otherwise the initials of the name in the colour keyed
     on the group id. `description` is the plain-text description beneath the headline, absent when
     empty. The second row is group 3, also in workspace 1: a long non-ASCII name, no image and a
     description at the 280-character limit. */
  $rows := [
    { "id": "1", "name": "keytec", "created": "2026-01-10", "updated": "2 hours ago", "projects": 3, "owner_user_id": "1", "initials": "K", "color": "attention", "image": "/themes/custom/bb_theme/logo.svg", "description": "keytec builds and runs bakers.build; its projects carry the platform and the design system." },
    { "id": "3", "name": "Ærøskøbing Søndergård Genossenschaft für Brückenbau und Küstenschutz", "created": "2026-04-12", "updated": "4 months ago", "projects": 0, "owner_user_id": "3", "initials": "ÆS", "color": "lease", "description": "A cooperative of harbour towns sharing one maintenance budget for bridges, quays and dikes along the coast: ÜberführungsbauwerkinstandsetzungsdokumentationsverzeichnisnachtragÜberführungsbauwerkinstandsetzungsdokumentationsverzeichnisnachtragÜberführungsbauwerkinstandsetzungsdoku" }
  ];
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": {
        "layout": "lines",
        "pattern": {
          "avatar": ["name_avatar"],
          "headline": ["name"],
          "description": ["description"],
          "right": ["projects"],
          "right_meta": ["changed"],
          "captions": { "changed": "Updated" }
        },
        "items": [$map($rows, function ($g) {
          (
            {
              "url": "/?path=/story/designbook-sections-projects-scenes--group-detail-overview",
              "cells": $merge([
                {
                  "name_avatar": $merge([
                    { "kind": "person", "initials": $g.initials, "color": $g.color, "size": "md", "image_fit": "contain" },
                    $g.image ? { "picture": $g.image } : {}
                  ]),
                  "name": { "kind": "link", "value": $g.name, "url": "/?path=/story/designbook-sections-projects-scenes--group-detail-overview" },
                  "changed": { "kind": "text", "value": $g.updated },
                  /* Drupal adds the tooltip ("N projects") as `title`/`aria-label` attributes on the
                     badge; the `badge` cell kind has no field for it. */
                  "projects": { "kind": "badge", "icon": "project", "label": $string($g.projects), "tone": "neutral" }
                },
                $g.description ? { "description": { "kind": "text", "value": $g.description } } : {},
                {}
              ])
            }
          )
        })]
      }
    }
  ]
)
