(
  /* THE GROUPS LISTING: `bb_theme:list` whose `rows` slot holds each group in its `list_item`
     view mode, as Drupal's `bb_rows` style renders `views.view.groups`. The row's look (avatar,
     linked name, description, project badge, "Updated") lives in
     `bb_group.bb_group.list_item.jsonata`, not here.

     A view mapping takes no record, so it names the listed records itself: groups 1 and 3, the
     two in workspace 1 that every screen of this section is scoped to (record 1, Northwind
     Trading, belongs to workspace 2). Group 3 carries the long non-ASCII name, no image and a
     280-character description. */
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:list",
      "props": { "layout": "lines" },
      "slots": {
        "rows": [
          { "type": "entity", "entity_type": "bb_group", "bundle": "bb_group", "view_mode": "list_item", "record": 0 },
          { "type": "entity", "entity_type": "bb_group", "bundle": "bb_group", "view_mode": "list_item", "record": 2 }
        ]
      }
    }
  ]
)
