(
  /* Account edit form (`user.user.default`) on `/user/{user}/edit`.
     Identity, nickname/mail and picture; Position and Background are on
     the Profile form mode. Onboarding uses its own Form API form.
     Picture is a file input here because Storybook has no crop widget. */
  $u := $;
  [
    {
      "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form",
      "slots": {
        "lines": [
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_label",
            "props": { "for": "edit-user-picture" },
            "slots": { "title": "Profile picture" }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_input",
            "props": {
              "type": "file",
              "name": "user_picture",
              "id": "edit-user-picture"
            }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_label",
            "props": { "for": "edit-field-full-name" },
            "slots": { "title": "Full name" }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_input",
            "props": {
              "name": "field_full_name",
              "id": "edit-field-full-name",
              "value": $u.field_full_name ? $u.field_full_name : $u.display_name
            }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_label",
            "props": { "for": "edit-name" },
            "slots": { "title": "Nickname (username)" }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_input",
            "props": {
              "name": "name",
              "id": "edit-name",
              "value": $u.name,
              "required": true
            }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_label",
            "props": { "for": "edit-mail" },
            "slots": { "title": "E-Mail-Adresse" }
          },
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:form_input",
            "props": {
              "type": "email",
              "name": "mail",
              "id": "edit-mail",
              "value": $u.mail
            }
          }
        ],
        "actions": [
          {
            "component": "$DESIGNBOOK_COMPONENT_NAMESPACE:button",
            "props": {
              "variant": "primary",
              "type": "submit",
              "label": "Save"
            }
          }
        ]
      }
    }
  ]
)
