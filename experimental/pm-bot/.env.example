# The keys the PM bot's container reads from its env file, /opt/data/.env (on the workspace:
# ~/.pm-bot/data/.env). The bakers-ddev Coder template writes the file from its workspace
# parameters on every start (coder/bakers-ddev/README.md › PM bot); edits to it are lost.
# The values below are examples, not defaults.

# Hermes' home inside the container, and the read-only clone the clone-reader sees.
HERMES_HOME=/opt/data
PM_BOT_CLONE_DIR=/opt/clone

# Model. An Anthropic API key, or a Claude subscription token (`claude setup-token`) for
# tests. Exactly one of the two.
PM_BOT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# bakers.build: the server, and the API key of the bot's service account, sent as the bearer on
# its /mcp. Hermes reads it from this file; it never lands in config.yaml.
BAKERS_URL=https://bakers.example.com
BAKERS_API_KEY=
# The project's UUID; every ticket the bot creates goes there.
PM_BOT_PROJECT=00000000-0000-4000-8000-000000000000
# Workflow of the tickets the bot creates (default bb_work).
PM_BOT_TICKET_WORKFLOW=bb_work
# The conductor (UUID) set on each new ticket. Empty: tickets wait until someone sets one.
PM_BOT_CONDUCTOR=
# Optional. Seconds between two polls (default 15).
PM_BOT_POLL_INTERVAL=15

# Slack app in Socket Mode.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs the bot answers in. Messages elsewhere are ignored.
SLACK_ALLOWED_CHANNELS=C0000000001
# Optional comma-separated member IDs. Empty: every user in the allowed channels, and the
# file carries GATEWAY_ALLOW_ALL_USERS=true.
SLACK_ALLOWED_USERS=
GATEWAY_ALLOW_ALL_USERS=true
# Operators: the only member IDs that may run Hermes slash commands. Must not be empty.
SLACK_ADMIN_USERS=U0000000009
# Optional. Hermes' home channel for its restart notices: a channel only the operators are in.
SLACK_HOME_CHANNEL=
# The workspace URL, for thread permalinks.
SLACK_WORKSPACE_URL=https://example.slack.com
