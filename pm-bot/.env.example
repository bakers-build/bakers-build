# The PM bot's configuration for one project. Copy to pm-bot/.env (ignored by git)
# and replace every value. The values below are examples, not defaults.

# Where Hermes keeps this bot's sessions, memory and rendered configuration.
# Outside the repository; your personal ~/.hermes is not touched.
HERMES_HOME=${HOME}/.hermes-pmbot

# Model. Use a Claude subscription token for local tests (`claude setup-token`), or an
# Anthropic API key. Set exactly one of the two.
PM_BOT_MODEL=claude-sonnet-5-5
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# bakers.build: the server and an API key of the bot's service account
# (Workspace → Service accounts → the account → API keys). The account needs a rank
# with ticket create and update rights in the project.
BAKERS_URL=https://bakers.example.com
BAKERS_CLIENT_ID=
BAKERS_CLIENT_SECRET=
# The project's UUID; every ticket the bot creates goes there.
PM_BOT_PROJECT=00000000-0000-4000-8000-000000000000
# Workflow of the tickets the bot creates: bb_work, or bb_autopilot for automatic approvals.
PM_BOT_TICKET_WORKFLOW=bb_work
# The conductor (UUID) set on each new ticket, which starts its qualification.
# Empty: tickets wait until someone sets one, and the bot says so in the thread.
PM_BOT_CONDUCTOR=
# Seconds between two polls (default 15).
PM_BOT_POLL_INTERVAL=15

# Slack app in Socket Mode (see README › Slack app).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs the bot answers in. Messages elsewhere are ignored.
SLACK_ALLOWED_CHANNELS=C0000000001
# Optional comma-separated member IDs. Empty: every user in the allowed channels.
SLACK_ALLOWED_USERS=
# Operators: the only Slack member IDs that may run Hermes slash commands (/hermes …);
# everyone else gets /help and /whoami. Must not be empty.
SLACK_ADMIN_USERS=U0000000009
# Hermes' home channel, for its restart and housekeeping notices: a channel only the
# operators are in. The bot must be a member.
SLACK_HOME_CHANNEL=C0000000008
# The workspace URL, for thread permalinks.
SLACK_WORKSPACE_URL=https://example.slack.com

# The project's repository and its secret-free, read-only clone.
PM_BOT_REPO_URL=git@gitlab.example.com:group/project.git
PM_BOT_CLONE_DIR=${HOME}/pm-bot-clones/project

# Optional log files for bin/start; without them the logs go to $HERMES_HOME/logs.
PM_BOT_GATEWAY_LOG=
PM_BOT_POLLER_LOG=
