#!/usr/bin/env bash
# Create or refresh the bot's clone of the customer repository: a sparse
# checkout without env files, Drupal settings, package-manager credentials and
# keys, so no secret is readable through the clone-reader.
set -euo pipefail

BOT="$(cd "$(dirname "$0")/.." && pwd)"
# Another user than the bot may refresh the clone, without access to the bot's env
# file: then PM_BOT_REPO_URL and PM_BOT_CLONE_DIR come from the environment.
if [ -r "$BOT/.env" ]; then
  set -a; . "$BOT/.env"; set +a
fi
: "${PM_BOT_REPO_URL:?pm-bot/.env: PM_BOT_REPO_URL is not set}"
: "${PM_BOT_CLONE_DIR:?pm-bot/.env: PM_BOT_CLONE_DIR is not set}"

# .git/config stays readable through the clone-reader, and it keeps the clone URL.
case "$(tr '[:upper:]' '[:lower:]' <<<"${PM_BOT_REPO_URL%%://*}")://${PM_BOT_REPO_URL#*://}" in
  http://*@* | https://*@* | *://*:*@*) echo "PM_BOT_REPO_URL carries credentials; use an SSH URL or a credential helper instead" >&2; exit 1 ;;
esac

# Secret files by name; each pattern is excluded from the checkout and checked for afterwards.
SECRETS=('.env*' 'settings*.php' 'services.local.yml' 'auth.json' '.npmrc' '*.pem' '*.key')

if [ ! -d "$PM_BOT_CLONE_DIR/.git" ]; then
  git clone --filter=blob:none --no-checkout "$PM_BOT_REPO_URL" "$PM_BOT_CLONE_DIR"
fi
git -C "$PM_BOT_CLONE_DIR" sparse-checkout set --no-cone '/*' "${SECRETS[@]/#/!**/}"
git -C "$PM_BOT_CLONE_DIR" checkout --quiet
git -C "$PM_BOT_CLONE_DIR" pull --quiet --ff-only

names=()
for pattern in "${SECRETS[@]}"; do names+=(-o -name "$pattern"); done
secrets="$(find "$PM_BOT_CLONE_DIR" -path "$PM_BOT_CLONE_DIR/.git" -prune -o \( "${names[@]:1}" \) -print)"
[ -z "$secrets" ] || { echo "secret files in the clone, remove them before starting the bot:" >&2; echo "$secrets" >&2; exit 1; }
echo "clone ready: $PM_BOT_CLONE_DIR"
