#!/usr/bin/env bash
# Fill the bot's HERMES_HOME from this folder and pm-bot/.env: the rendered
# config.yaml, SOUL.md, the env file, the pm-relay server with its bakers.build client and the project-manager
# skill with its rendered project reference. Idempotent; rerun after changing any of them.
set -euo pipefail

BOT="$(cd "$(dirname "$0")/.." && pwd)"
# The one Hermes version this bot is written and checked against.
HERMES_VERSION=0.22.5
HERMES_COMMIT=bf0203a7

[ -f "$BOT/.env" ] || { echo "pm-bot/.env is missing: copy pm-bot/.env.example and fill it in" >&2; exit 1; }
chmod 600 "$BOT/.env"
set -a; . "$BOT/.env"; set +a
: "${HERMES_HOME:?pm-bot/.env: HERMES_HOME is not set}"
for key in BAKERS_URL BAKERS_CLIENT_ID BAKERS_CLIENT_SECRET PM_BOT_PROJECT PM_BOT_TICKET_WORKFLOW SLACK_ALLOWED_CHANNELS; do
  [ -n "${!key:-}" ] || { echo "pm-bot/.env: $key is not set" >&2; exit 1; }
done

command -v hermes >/dev/null || { echo "hermes is not installed: see pm-bot/README.md › Install Hermes" >&2; exit 1; }
# The first line reads like: Hermes Agent v0.22.5 (2026.9.24) · stable · local bf0203a794a0
version="$(hermes --version 2>&1 | head -1)"
[[ "$version" == *" v$HERMES_VERSION "*" local $HERMES_COMMIT"* ]] \
  || { echo "hermes is not v$HERMES_VERSION (commit $HERMES_COMMIT): $version" >&2; exit 1; }

# Replace each dollar-brace placeholder with its value from the env file. An unset value stops
# the render, and so does one that could change the YAML's structure: values are single words
# of URL and path characters, so no space, newline, quote, comment or flow character gets in.
render() {
  perl -pe 's/\$\{(\w+)\}/value($1)/ge;
    sub value { my $v = $ENV{$_[0]};
      die "pm-bot\/.env: $_[0] is not set\n" unless defined $v && length $v;
      die "pm-bot\/.env: $_[0] may hold only letters, digits and . _ ~ : \/ , @ + = % -, starting with a letter, digit, \/ or .\n"
        unless $v =~ m{\A[A-Za-z0-9.\/][A-Za-z0-9._~:\/,@+=%-]*\z};
      $v }' "$1" > "$2.tmp" \
    || { rm -f "$2.tmp"; exit 1; }
  mv "$2.tmp" "$2"
}

mkdir -p "$HERMES_HOME/skills"
chmod 700 "$HERMES_HOME"
render "$BOT/config.template.yaml" "$HERMES_HOME/config.yaml"
ln -sfn "$BOT/SOUL.md" "$HERMES_HOME/SOUL.md"
ln -sfn "$BOT/.env" "$HERMES_HOME/.env"
mkdir -p "$HERMES_HOME/pm-relay" "$HERMES_HOME/lib"
cp "$BOT/relay/server.mjs" "$HERMES_HOME/pm-relay/server.mjs"
cp "$BOT/lib/bakers-client.mjs" "$HERMES_HOME/lib/bakers-client.mjs"

skill="$HERMES_HOME/skills/project-manager"
rm -rf "$skill"
cp -R "$BOT/skills/project-manager" "$skill"
render "$skill/references/project.template.md" "$skill/references/project.md"
rm "$skill/references/project.template.md"

echo "HERMES_HOME=$HERMES_HOME is ready. Next: pm-bot/bin/start"
