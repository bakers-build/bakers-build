#!/usr/bin/env bash
# Stop the gateway and the poller that bin/start launched.
set -euo pipefail

BOT="$(cd "$(dirname "$0")/.." && pwd)"
set -a; . "$BOT/.env"; set +a
. "$BOT/lib/running.sh"

for entry in "gateway gateway" "poller poller.mjs"; do
  name="${entry% *}"
  pid="$HERMES_HOME/pm-bot-$name.pid"
  if running "$pid" "${entry#* }" && kill "$(cat "$pid")" 2>/dev/null; then
    echo "$name stopped"
  else
    echo "$name was not running"
  fi
  rm -f "$pid"
done
