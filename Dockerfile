# Multi-stage Drupal build. Generated by keytec-drupal-deploy (recipe: komodo).
# Theme asset build stage (bb_theme, vite). composer patches (extra.patches)
# are copied into the PHP stage before `composer install` — see below.

# --- Theme asset build stage ---
# bb_theme ships its sources but not dist/ (gitignored), so the assets must be
# built here. Pin pnpm 11.5.2 (the version the wodby web image runs, and the one
# the committed lockfile installs cleanly — pnpm 9 trips over the overrides entry).
FROM node:22-bookworm-slim AS theme
# The repository layout is kept so vite.config.js finds docs/scripts/third-party.mjs.
WORKDIR /repo/web/themes/custom/bb_theme
# CI=true: non-interactive (no purge-confirm TTY prompt). verify-deps-before-run=false:
# pnpm 11 otherwise re-checks deps before `pnpm build` and tries to reinstall — the
# install layer already satisfies the lockfile, so skip the redundant recheck.
ENV CI=true \
    npm_config_verify_deps_before_run=false
RUN corepack enable && corepack prepare pnpm@11.5.2 --activate
# Lockfile + pnpm-workspace.yaml (holds the `overrides` the lockfile is pinned
# to — without it frozen install fails ERR_PNPM_LOCKFILE_CONFIG_MISMATCH) first,
# so the dependency install layer caches across source-only changes.
COPY web/themes/custom/bb_theme/package.json \
     web/themes/custom/bb_theme/pnpm-lock.yaml \
     web/themes/custom/bb_theme/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/themes/custom/bb_theme ./
COPY docs/scripts/third-party.mjs /repo/docs/scripts/third-party.mjs
RUN pnpm build

# --- PHP / Drupal stage ---
FROM wodby/drupal-php:8.4-4.82.1 AS php

ENV DOCROOT_SUBDIR="" \
    APP_NAME="Drupal"

WORKDIR ${APP_ROOT}
# Disable client-side TLS for the MariaDB CLI (drush sql:*); the deployed
# wodby/mariadb server has no TLS and newer clients otherwise require it.
# Force 0644: MariaDB IGNORES a world-writable config file (the CI runner may
# check out with a permissive umask, yielding 0666 → the cnf is silently
# dropped and drush sql:* / site:install fail with "SSL is required").
COPY --chmod=0644 komodo/client-no-ssl.cnf /etc/my.cnf.d/zz-disable-ssl.cnf
# PHP memory_limit. wodby ships CLI = -1 (unbounded, conf.d/docker-php.ini) and
# FPM = 512M (php-fpm.d/zz-www.conf), but it RENDERS both files from gomplate
# templates at container START, not at build time — so a build-time `sed` on them
# fails with "No such file or directory" (the file the RUN edits does not exist
# yet). Set the values the supported way instead.
# An unbounded CLI let `drush deploy` grow to ~2.5 GB during search_api indexing
# and the OS OOM-killer took the whole host down (deploy exit 1 → php/nginx never
# start → ingress 404). Cap CLI at 384M via a conf.d drop-in that loads after
# docker-php.ini (alphabetical), so a runaway process fails cleanly (PHP fatal)
# instead of OOM-killing neighbours. Lower FPM to a web-appropriate 256M via
# $PHP_MEMORY_LIMIT, which zz-www.conf.tmpl reads; the FPM pool's php_value wins
# over the conf.d drop-in, so FPM stays 356M while the CLI is 384M.
# Raised 256M → 356M: a conductor tick request fetched several bb_run rows
# whose multi-MB `log` fields (13–24 MB each) are loaded whole by the entity
# layer, and a 69 MB allocation over the old 256M cap threw a PHP Fatal
# (PdoTrait::fetch) → HTML error page → the conductor's JSON parse failed and
# every tick errored. This is a stopgap; the real fix is bounding the run log
# at write time so it never grows this large.
ENV PHP_MEMORY_LIMIT=356M
RUN printf 'memory_limit = 384M\n' > /usr/local/etc/php/conf.d/zz-memory-cli.ini
USER wodby
COPY --chown=wodby composer.* ${APP_ROOT}
# Patch files must be present BEFORE `composer install`: cweagans/composer-patches
# applies extra.patches during the install, and a missing local patch file surfaces
# as `RemoteFilesystem::copy(): $originUrl must be string, null given`. Copied on
# their own layer (before the full source COPY below) so the install cache only
# busts when a patch actually changes.
COPY --chown=wodby patches ${APP_ROOT}/patches
# Optional `composer_auth` secret (COMPOSER_AUTH JSON): GitHub throttles anonymous dist downloads
# from shared CI runners. Mounted for this RUN only, never in a layer; absent, nothing changes.
RUN --mount=type=secret,id=composer_auth,required=false,mode=0444 \
    if [ -s /run/secrets/composer_auth ]; then export COMPOSER_AUTH="$(cat /run/secrets/composer_auth)"; fi; \
    composer install --no-dev --no-interaction --no-progress --prefer-dist
COPY --chown=wodby . ${APP_ROOT}
# Built theme assets (dist/ is gitignored, so absent from the build context above).
COPY --chown=wodby --from=theme /repo/web/themes/custom/bb_theme/dist ${APP_ROOT}/web/themes/custom/bb_theme/dist

# --- Nginx stage ---
FROM wodby/nginx:1.27-5.39.11 AS nginx
USER root
COPY --chown=root --from=php /var/www/html /var/www/html
# BB-688: route /.well-known/oauth-* to Drupal (NGINX_SERVER_EXTRA_CONF_FILEPATH below).
COPY --chown=root docker/nginx/oauth-discovery.conf /etc/nginx/oauth-discovery.conf
# http-level rate-limit zone for /oauth/register (applied in oauth-discovery.conf).
COPY --chown=root docker/nginx/oauth-register-zone.conf /etc/nginx/conf.d/oauth-register-zone.conf

# --- Docs site build stage ---
# The VitePress site (docs/) plus the plugin marketplace: marketplace.json and
# plugins/bakers-<version>.zip (docs/scripts/marketplace.mjs). Same pnpm pin and settings as
# the theme stage; pnpm 11 fails on esbuild's ignored build script without the last one.
FROM node:22-bookworm-slim AS docs-build
WORKDIR /repo/docs
ENV CI=true \
    npm_config_verify_deps_before_run=false \
    PNPM_CONFIG_MINIMUM_RELEASE_AGE=0 \
    PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS=true
RUN corepack enable && corepack prepare pnpm@11.5.2 --activate
COPY docs/package.json docs/pnpm-lock.yaml docs/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY docs /repo/docs
COPY .claude-plugin /repo/.claude-plugin
COPY .claude/skills/bakers-build /repo/.claude/skills/bakers-build
# The docs build reads addon option schemas, shared schemas and included addon docs (docs/.vitepress/addon-options.mjs).
COPY bakers-cli/addons /repo/bakers-cli/addons
COPY bakers-cli/core/schema /repo/bakers-cli/core/schema
# The sidebar's version row (docs/.vitepress/config.mts): target branch and commit.
ARG CI_COMMIT_REF_NAME CI_COMMIT_SHORT_SHA
RUN pnpm build

# --- Docs stage: the public docs and marketplace host, static ---
FROM nginx:1.27.5-alpine AS docs
COPY docker/docs/default.conf /etc/nginx/conf.d/default.conf
COPY --chmod=0755 docker/docs/marketplace-host.sh /docker-entrypoint.d/40-marketplace-host.sh
COPY --from=docs-build /repo/docs/.vitepress/dist /usr/share/nginx/html

# --- PHPUnit stage (CI merge gate only, never deployed) ---
# The shipped `php` image plus the dev dependencies, so the gate's `phpunit` job runs
# the unit and kernel tests on the shipped code and PHP runtime.
FROM php AS php-test
RUN composer install --no-interaction --no-progress --prefer-dist
