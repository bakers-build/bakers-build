#!/bin/bash
## Description: Reinstall the selected local Bakers site (destroys its database)
## Usage: init [--provider existing-config|recipe|recipe-test] [--fresh]
## Example: "ddev init --provider recipe-test"
set -euo pipefail
provider=existing-config
while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) [ "$#" -ge 2 ] || { echo 'Missing provider' >&2; exit 1; }; provider="$2"; shift 2 ;;
    --fresh) shift ;; # Compatibility: every explicit init is a fresh install.
    *) echo "Unsupported init argument: $1" >&2; exit 1 ;;
  esac
done
case "$provider" in existing-config|recipe|recipe-test) ;; *) echo 'Unsupported init provider' >&2; exit 1 ;; esac
cd "${DDEV_APPROOT:-$(pwd)}"
node scripts/setup-worktree.mjs
# Check the registry before startup: an existing name must belong to this exact root.
ddev list -j | node --input-type=module -e '
import { readFileSync, realpathSync } from "node:fs";
const root = realpathSync(".");
const name = [...readFileSync(".env.ddev", "utf8").matchAll(/^DDEV_WORKTREE_NAME=(.*)$/gm)].at(-1)[1];
const projects = JSON.parse(readFileSync(0, "utf8")).raw;
if (!Array.isArray(projects)) throw new Error("Cannot verify DDEV registry");
for (const project of projects) {
  let path = project.approot;
  try { path = realpathSync(path); } catch {}
  if ((project.name === name && path !== root) || (path === root && project.name !== name)) {
    throw new Error("DDEV name/approot collision; reconcile the registry before installing.");
  }
}
'
ddev describe -j | node --input-type=module -e '
import { readFileSync, realpathSync } from "node:fs";
const name = [...readFileSync(".env.ddev", "utf8").matchAll(/^DDEV_WORKTREE_NAME=(.*)$/gm)].at(-1)[1];
const project = JSON.parse(readFileSync(0, "utf8")).raw;
if (project.name !== name || realpathSync(project.approot) !== realpathSync(".")) {
  throw new Error("Effective DDEV name/approot differs from prepared identity; refusing installation.");
}
'
ddev start
ddev composer install
ddev exec 'cd web/themes/custom/bb_theme && pnpm install --frozen-lockfile && pnpm build'
case "$provider" in
  existing-config)
    mkdir -p .ddev/.bakers-test
    ddev drush site:install --existing-config -y 2>&1 | tee .ddev/.bakers-test/init-existing-config.log
    ;;
  recipe)
    ddev exec bash /var/www/html/.ddev/providers/recipe-install.sh recipe /var/www/html/.ddev/commands/web/bakers-init-playground
    ;;
  recipe-test)
    ddev exec bash /var/www/html/.ddev/providers/recipe-install.sh recipe-test /var/www/html/.ddev/commands/web/bakers-init-test
    ;;
esac
