#!/bin/bash
## Description: Run bakers.build conductor Vitest integration tests (inside web container)
## Usage: bakers-test-integration

set -euo pipefail

ARTIFACT_DIR=/var/www/html/.ddev/.bakers-test
ENV_FILE="${ARTIFACT_DIR}/env"
CONDUCTOR_DIR=/var/www/html/bakers-cli

if [ ! -f "${ENV_FILE}" ]; then
  echo "ERROR: ${ENV_FILE} is missing. Run 'ddev init --provider recipe-test' first." >&2
  exit 1
fi

echo "==> Building bakers.build conductor workspace"
(
  cd "${CONDUCTOR_DIR}"
  CI=true PNPM_CONFIG_MINIMUM_RELEASE_AGE=0 PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS=true npx --yes pnpm install --frozen-lockfile --store-dir "${CONDUCTOR_DIR}/.pnpm-store"
  CI=true PNPM_CONFIG_MINIMUM_RELEASE_AGE=0 PNPM_CONFIG_DANGEROUSLY_ALLOW_ALL_BUILDS=true npx --yes pnpm run build:all
)

exec bash /var/www/html/scripts/e2e/run-integration.sh "${ENV_FILE}"
