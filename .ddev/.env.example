#ddev-generated
# keytec PROJECT secrets — copy to .ddev/.env and fill. NEVER commit .ddev/.env.
# Tier A (read token, PLATFORMSH_CLI_TOKEN) is set ONCE globally, not here:
#   ddev config global --web-environment-add="KEYTEC_REGISTRY_TOKEN=<read-token>"
# Publisher only (prod access):
KEYTEC_REGISTRY_WRITE_TOKEN=
# The raw pull is done by sanitize.pull_provider (a DDEV provider). Any secrets it needs go here,
# e.g. a Platform.sh pull provider also needs:
#   PLATFORM_PROJECT=
#   PLATFORM_ENVIRONMENT=main
# A provider that reaches prod over ssh/drush aliases needs NO secret here — it uses your own
# ~/.ssh/config, keys and drush aliases.
