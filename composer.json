{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^1.7.3",
        "drupal/admin_toolbar": "^3.6",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/core-recipe-unpack": "^11.3",
        "drupal/core-recommended": "^11.3",
        "drupal/crop": "^2.6",
        "drupal/devel_entity_updates": "^5.0",
        "drupal/display_builder": "^1.0@beta",
        "drupal/entity": "^1.6",
        "drupal/facets": "^3.0",
        "drupal/formblock": "^2.0@beta",
        "drupal/formdazzle": "^4.0",
        "drupal/gin": "^5",
        "drupal/gin_toolbar": "^3.0",
        "drupal/jsonapi_resources": "^1",
        "drupal/jsonapi_schema": "^1.0",
        "drupal/markdown_easy": "^1.0",
        "drupal/migrate_plus": "^6",
        "drupal/migrate_tools": "^6",
        "drupal/og": "^2.0",
        "drupal/plugin": "^2.14",
        "drupal/r4032login": "^2.2",
        "drupal/schemata": "^1.0",
        "drupal/schemata_json_schema": "^1.0",
        "drupal/search_api": "^1.38",
        "drupal/simple_oauth": "^6",
        "drupal/social_auth": "^4.1",
        "drupal/social_auth_google": "^4.0",
        "drupal/state_machine": "^1.14",
        "drupal/tagify": "^1.2",
        "drupal/ui_icons": "^1.1",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_filters_summary": "^3.4",
        "drush/drush": "~13.6.0",
        "e0ipso/simple_oauth_21": "^1.13",
        "justinrainbow/json-schema": "^6.9"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "cweagans/composer-patches": true
        },
        "audit": {
            "ignore": {
                "PKSA-jj5t-2zs1-dcfm": "guzzlehttp/psr7 advisory; psr7 pinned by drupal/core-recommended ~2.8.0, no fixed release available within the core constraint yet",
                "PKSA-gm5x-j3mz-71n9": "guzzlehttp/psr7 advisory; psr7 pinned by drupal/core-recommended ~2.8.0, no fixed release available within the core constraint yet"
            }
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/display_builder": {
                "Fix the config schema of the views display extender (BB-413)": "patches/display_builder-views-sources-schema.patch"
            },
            "drupal/social_api": {
                "PHP 8.4 implicit-nullable-parameter deprecation on OAuth2Manager::__construct() (BB-476)": "patches/social_api-php84-nullable-request.patch"
            }
        },
        "_comment-patches-ignore": [
            "WHY THE ONE SUPPRESSED PATCH IS SUPPRESSED (BB-413). JSON carries no",
            "comment syntax, so this is an inert `extra` key beside the entry it explains;",
            "the long form is in docs/specs/BB-413-wire-the-ticket-list.spec.md.",
            "WHAT IT IS: drupal/display_builder declares a patch against drupal/ui_patterns",
            "-- merge request 478, issue 3570294, 'do not throw error on missing",
            "component'. It makes ComponentElementBuilder catch every Throwable raised",
            "while resolving a component and return a ui_patterns:status placeholder",
            "instead, adding an SDC, a constructor argument and a ui_patterns.services.yml",
            "edit to do it.",
            "WHY THIS TREE DECLINES IT, two reasons and either is sufficient. (1) The URL",
            "is an unpinned merge-request HEAD, so its content is whatever the MR says",
            "today: measured 2026-09-05 it serves four commits and 296 lines, not the",
            "single 92-line commit display_builder's own entry describes. Fetching it in",
            "every `composer install` would make the Docker image build, CI and `ddev init`",
            "network-dependent and non-reproducible. (2) Turning a missing component into a",
            "logged placeholder is the wrong direction for this repository, whose component",
            "gates rest on a broken reference FAILING: ui_patterns already drops invalid",
            "props silently, and a second silent degradation would hide exactly what the",
            "Storybook, contract and Playwright gates exist to catch.",
            "WHAT WOULD REMOVE THIS ENTRY: MR 478 landing in a tagged ui_patterns release,",
            "after which display_builder drops its own patch entry and this one becomes",
            "dead weight -- or display_builder pinning it to an immutable commit diff AND",
            "this repository deciding it wants the placeholder behaviour after all."
        ],
        "patches-ignore": {
            "drupal/display_builder": {
                "drupal/ui_patterns": [
                    "https://git.drupalcode.org/project/ui_patterns/-/merge_requests/478.patch"
                ]
            }
        }
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "drupal/config_inspector": "^2.1",
        "drupal/core-dev": "^11.3",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    }
}
