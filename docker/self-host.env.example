# Copy to .env in a private installation directory; never commit the real file.
COMPOSE_PROJECT_NAME=bakers
STACK_NAME=bakers
COMPOSE_PROFILES=
DOMAIN=
ACME_EMAIL=
# Pick an unused private IPv4 subnet; check host, VPN and Docker networks first.
TRAEFIK_SUBNET=
TRAEFIK_IMAGE=traefik:v3.6.1
# The same release for both, pinned by digest, e.g.
# ghcr.io/bakers-build/bakers-build/php:X.Y.Z@sha256:<digest> and ghcr.io/bakers-build/bakers-build/nginx:X.Y.Z@sha256:<digest>
REGISTRY_IMAGE_PHP=
REGISTRY_IMAGE_NGINX=
DB_NAME=bakers
DB_USER=bakers
DB_PASSWORD=
DB_ROOT_PASSWORD=
DRUPAL_HASH_SALT=
# Percent-encode credentials in the SMTP URL; single-quote values containing $.
MAIL_SMTP_DSN=
MAIL_FROM_ADDRESS=
# Optional Google login. Register the redirect URI for DOMAIN with your provider.
BB_OAUTH_GOOGLE_CLIENT_ID=
BB_OAUTH_GOOGLE_CLIENT_SECRET=
